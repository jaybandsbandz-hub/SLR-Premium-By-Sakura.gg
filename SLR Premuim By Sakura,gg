            local inputTypeName = tostring(i.UserInputType)
            local keyCodeName = tostring(i.KeyCode)
            local inputTypeValue = i.UserInputType.Value
            local keyCodeValue = i.KeyCode.Value
            
            if inputTypeValue == 3 or inputTypeValue == 4 or inputTypeValue == 5 or inputTypeValue == 6 then
                conn:Disconnect()
                listening = false
                if inputTypeValue == 3 or inputTypeValue == 5 then
                    SetState("MouseButton4")
                else
                    SetState("MouseButton5")
                end
                return
            end
            
            if not SakuraInputIsGamepadType(i.UserInputType) and keyCodeValue >= 1000 then
                conn:Disconnect()
                listening = false
                SetState("MouseButton4")
                return
            end
            
            if keyCodeName:match("ButtonX1") or inputTypeName:match("MouseButton4") or inputTypeName:match("Button4") or keyCodeName:match("X1") then
