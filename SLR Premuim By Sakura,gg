        local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
        if not hrp then
            local head = char:FindFirstChild("Head")
            if head then
                hrp = head
            end
        end
        if not (hum and hrp and hum.Health > 0 and Plrs:GetPlayerFromCharacter(char) == nil) then
            NpcEspRaySeen[model] = nil
            NpcEspVisBlend[model] = nil
            npcFarChamState[model] = nil
            destroyModernEspFarChamNpc(model)
            local tag = espFolder:FindFirstChild("NpcESP_" .. npcEspStableId(model))
            if tag then
                tag.Enabled = false
            end
            local highlight = char:FindFirstChild("EliteHubNpcHighlight")
            if highlight then
                highlight.Enabled = false
            end
            return
        end
        if not myHrp or (hrp.Position - myHrp.Position).Magnitude > NPC_ESP_RANGE_STUDS then
            NpcEspRaySeen[model] = nil
            NpcEspVisBlend[model] = nil
            npcFarChamState[model] = nil
            destroyModernEspFarChamNpc(model)
            local tag = espFolder:FindFirstChild("NpcESP_" .. npcEspStableId(model))
            if tag then
                tag.Enabled = false
            end
            local highlightFar = char:FindFirstChild("EliteHubNpcHighlight")
            if highlightFar then
                highlightFar.Enabled = false
            end
            return
        end
        local distance = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
        local camDist = (cam and hrp) and (hrp.Position - cam.CFrame.Position).Magnitude or distance
        local mx = math.max(camDist, distance)
        local th = MODERN_ESP_FAR_CHAM_STUDS
        local prevFar = npcFarChamState[model]
        local useFarCham
        if prevFar == nil then
            useFarCham = (camDist > th) or (distance > th)
        elseif prevFar == true then
            useFarCham = mx > (th - 55)
        else
            useFarCham = (camDist > (th + 35)) or (distance > (th + 35))
        end
        npcFarChamState[model] = useFarCham
        local isVisible
        if (((rayFrame + #model.Name * 17) % 3) == 1) or (NpcEspRaySeen[model] == nil) then
            isVisible = modernEspRayVisible(hrp, char, myHrp, myHead, cam)
        else
            isVisible = NpcEspRaySeen[model]
        end
        NpcEspRaySeen[model] = isVisible
        local visTarget = isVisible and 1 or 0
        local blended = NpcEspVisBlend[model] or visTarget
        blended = blended + (visTarget - blended) * 0.2
        if math.abs(blended - visTarget) < 0.012 then
            blended = visTarget
        end
        NpcEspVisBlend[model] = blended
        local espColor = espColors.Visible:Lerp(espColors.Hidden, 1 - blended)
        local lockChar = getgenv().EliteHubLockedAimCharacter
        if lockChar and lockChar == model then
                    espColor = espColors.Visible:Lerp(espColors.Hidden, 0.5)
        end
        modernEspUpdateNpcBillboard(model, hrp, hum, distance, espColor)
        modernEspSyncNpcHighlight(model, char, hrp, espColor, isVisible, useFarCham)
    end

    local EspHudColorKey = nil
    local EspHudColors = nil
    local EspRaySeen = {}
    local EspVisBlend = {}

    getgenv().SakuraInvalidateEspHudColors = function()
        EspHudColorKey = nil
        EspHudColors = nil
    end

    local modernEspRayFrame = 0
    local modernEspUnderMenuCover = false

    local function modernEspClearWhenDisabled(plrList)
        for k in pairs(EspRaySeen) do
            EspRaySeen[k] = nil
        end
        for k in pairs(EspVisBlend) do
            EspVisBlend[k] = nil
        end
        clearAllModernEspFarChams()
        for _, plr in ipairs(plrList) do
            if plr ~= LocalPlayer then
                local espTag = espFolder:FindFirstChild(plr.Name .. "_ESP")
                if espTag then
                    espTag.Enabled = false
                end
                local char = plr.Character
                local highlight = char and char:FindFirstChild("EliteHubHighlight")
                if highlight then
                    highlight.Enabled = false
                end
            end
        end
    end

    local function modernEspUpdateBillboard(plr, hrp, hum, distance, espColor)
                local showAnyText = getgenv().ESPShowNames or getgenv().ESPShowDistance or getgenv().ESPShowHealth
        if not showAnyText then
            local tagOff = espFolder:FindFirstChild(plr.Name .. "_ESP")
            if tagOff then
                tagOff.Enabled = false
            end
            return
        end
                    local espTag = espFolder:FindFirstChild(plr.Name .. "_ESP")
                    if not espTag then
                        espTag = Instance.new("BillboardGui")
                        espTag.Name = plr.Name .. "_ESP"
                        espTag.Parent = espFolder
                        espTag.AlwaysOnTop = true
                        espTag.Size = UDim2.new(0, 200, 0, 50)
                        espTag.StudsOffset = Vector3.new(0, 3.5, 0)
                        local txt = Instance.new("TextLabel", espTag)
                        txt.Name = "Label"
                        txt.Size = UDim2.new(1, 0, 1, 0)
                        txt.BackgroundTransparency = 1
                        txt.Font = Enum.Font.GothamBold
                        txt.TextSize = 13
                        txt.TextStrokeTransparency = 0.2
                        txt.RichText = true
                    end
                    espTag.Adornee = hrp
                    espTag.Enabled = true
                    if distance >= 850 then
                        espTag.StudsOffset = Vector3.new(0, 18, 0)
                    elseif distance >= 600 then
                        espTag.StudsOffset = Vector3.new(0, 15, 0)
                    elseif distance >= 400 then
                        espTag.StudsOffset = Vector3.new(0, 12, 0)
                    elseif distance >= 250 then
                        espTag.StudsOffset = Vector3.new(0, 10, 0)
                    elseif distance >= 125 then
                        espTag.StudsOffset = Vector3.new(0, 8, 0)
                    else
                        espTag.StudsOffset = Vector3.new(0, 4, 0)
                    end
                    local espText = ""
                    if getgenv().ESPShowNames then
                        espText = plr.Name
                    end
                    if getgenv().ESPShowDistance then
                        local distColor = espColor
            local r = math.floor(distColor.R * 255)
            local g = math.floor(distColor.G * 255)
            local b = math.floor(distColor.B * 255)
                        espText = espText .. (espText ~= "" and "\n" or "") .. "<font color='rgb(" .. r .. "," .. g .. "," .. b .. ")'>" .. distance .. "m</font>"
                    end
                    if getgenv().ESPShowHealth then
                        local hpStr = math.floor(hum.Health)
                        espText = espText .. (espText ~= "" and " | " or "") .. "<font color='rgb(100,255,100)'>" .. hpStr .. " HP</font>"
                    end
                    if espTag.Label.Text ~= espText then
                        espTag.Label.Text = espText
                    end
                    if espTag.Label.TextColor3 ~= espColor then
                        espTag.Label.TextColor3 = espColor
                    end
                end
                
    local function modernEspSyncHighlight(plr, char, hrp, espColor, isVisible, useFarCham)
                if getgenv().AutoESP then
            pcall(function()
                local orphan = espFolder:FindFirstChild("PlrHL_" .. tostring(plr.UserId))
                if orphan and orphan:IsA("Highlight") then
                    orphan:Destroy()
                end
            end)
                    local highlight = char:FindFirstChild("EliteHubHighlight")
                    if not highlight then
                        highlight = Instance.new("Highlight")
                        highlight.Name = "EliteHubHighlight"
                        highlight.Parent = char
                highlight.FillTransparency = 0.62
                        highlight.OutlineTransparency = 0.1
                    end
            pcall(function()
                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            end)
                    highlight.FillColor = espColor
                    highlight.OutlineColor = espColor
            local gameSafe = characterHasGameSafeZoneStyleHighlight(char)
            local deferToGame = gameSafe and isVisible
            if deferToGame then
                highlight.Enabled = false
                destroyModernEspFarCham(plr)
            elseif useFarCham then
                highlight.Enabled = false
                syncModernEspFarCham(plr, hrp, espColor)
            else
                destroyModernEspFarCham(plr)
                highlight.Enabled = true
                end
            else
            destroyModernEspFarCham(plr)
            local highlightOff = char:FindFirstChild("EliteHubHighlight")
            if highlightOff then
                highlightOff.Enabled = false
            end
        end
    end

    local function modernEspUpdateRemotePlayer(plr, myHrp, myHead, cam, espColors, rayFrame)
        local char = plr.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if not (hum and hrp and hum.Health > 0) then
            EspRaySeen[plr] = nil
            EspVisBlend[plr] = nil
            destroyModernEspFarCham(plr)
                local espTag = espFolder:FindFirstChild(plr.Name .. "_ESP")
            if espTag then
                espTag.Enabled = false
            end
                local highlight = char and char:FindFirstChild("EliteHubHighlight")
            if highlight then
                highlight.Enabled = false
            end
            return
        end
        local distance = myHrp and math.floor((myHrp.Position - hrp.Position).Magnitude) or 0
        local camDist = (cam and hrp) and (hrp.Position - cam.CFrame.Position).Magnitude or distance
        local useFarCham = camDist > MODERN_ESP_FAR_CHAM_STUDS or distance > MODERN_ESP_FAR_CHAM_STUDS
        local isVisible
        if (((rayFrame + plr.UserId) % 3) == 1) or (EspRaySeen[plr] == nil) then
            isVisible = modernEspRayVisible(hrp, char, myHrp, myHead, cam)
        else
            isVisible = EspRaySeen[plr]
        end
        EspRaySeen[plr] = isVisible
        local visTarget = isVisible and 1 or 0
        local blended = EspVisBlend[plr] or visTarget
        blended = blended + (visTarget - blended) * 0.14
        if math.abs(blended - visTarget) < 0.012 then
            blended = visTarget
        end
        EspVisBlend[plr] = blended
        local espColor = espColors.Visible:Lerp(espColors.Hidden, 1 - blended)
        if getgenv().EliteHubLockedTarget == plr then
            espColor = espColors.Visible:Lerp(espColors.Hidden, 0.5)
        end
        modernEspUpdateBillboard(plr, hrp, hum, distance, espColor)
        modernEspSyncHighlight(plr, char, hrp, espColor, isVisible, useFarCham)
    end

    ConnectCore("ModernESP", Services.RunService.RenderStepped, function()
        if SakuraIsMainMenuCovering() then
            if not modernEspUnderMenuCover then
                modernEspUnderMenuCover = true
                modernEspClearWhenDisabled(Services.Players:GetPlayers())
                modernEspClearNpcEspAll()
            end
            return
        end
        modernEspUnderMenuCover = false
        local g = getgenv()
        local anyPlayerEspUi = g.AutoESP or g.ESPShowNames or g.ESPShowDistance or g.ESPShowHealth
        local anyNpcEspUi = g.NpcESP_Chams or g.NpcESP_ShowNames or g.NpcESP_ShowDistance or g.NpcESP_ShowHealth
        local plrList = Plrs:GetPlayers()
        if not anyPlayerEspUi then
            modernEspClearWhenDisabled(plrList)
        end
        if not anyNpcEspUi then
            modernEspClearNpcEspAll()
        end
        if not anyPlayerEspUi and not anyNpcEspUi then
            return
        end
        if EspHudColorKey ~= CurrentTheme then
            EspHudColorKey = CurrentTheme
            EspHudColors = GetEspColors()
        end
        local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        local myHead = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head")
        local cam = workspace.CurrentCamera
        local espColors = EspHudColors or GetEspColors()
        modernEspRayFrame += 1
        local rf = modernEspRayFrame
        if anyPlayerEspUi then
            for _, plr in ipairs(plrList) do
                if plr ~= LocalPlayer then
                    modernEspUpdateRemotePlayer(plr, myHrp, myHead, cam, espColors, rf)
                end
            end
        end
        local drewNpc = {}
        if anyNpcEspUi then
            ensureNpcEspList()
            for _, m in ipairs(npcEspList) do
                modernEspUpdateNpc(m, myHrp, myHead, cam, espColors, rf)
                drewNpc[m] = true
            end
            cleanupOrphanNpcEspFarChams(npcEspList)
        end
        for m in pairs(lastNpcEspTracked) do
            if not drewNpc[m] then
                destroyModernEspFarChamNpc(m)
                local tag = espFolder:FindFirstChild("NpcESP_" .. npcEspStableId(m))
                if tag then
                    pcall(function()
                        tag:Destroy()
                    end)
                end
                pcall(function()
                    if m.Parent then
                        local h = m:FindFirstChild("EliteHubNpcHighlight")
                        if h then
                            h.Enabled = false
                        end
                    end
                end)
            end
        end
        lastNpcEspTracked = drewNpc
        cleanupOrphanModernEspFarChams(plrList, LocalPlayer)
    end)
end)()

