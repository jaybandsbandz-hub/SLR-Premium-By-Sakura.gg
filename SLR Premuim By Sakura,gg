-- outerScale: MainFrame-style halo, scaled. Default ~0.16 for a bit more bloom than 0.145.
local function addChasingMenuGlow(target, destGradients, chaseThickness, strong, outerScale)
    if not target or not destGradients then
        return
    end
    strong = strong == true
    local oScale = outerScale
    if oScale == true then
        oScale = 0.16
    end
    if type(oScale) == "number" and oScale > 0 then
        local ringBoost = 1.1
        for i = 10, 1, -1 do
            -- Same as MainFrame outer glow, slightly boosted for a bigger bloom
            local thickness = (6 + (i - 1) * 2.2) * oScale * ringBoost
            if thickness < 0.22 then
                thickness = 0.22
            end
            local transparency = 0.91 + (i - 1) * 0.0075
            if transparency > 0.99 then
                transparency = 0.99
            end
            local s = Instance.new("UIStroke", target)
            s.Name = "OuterMenuGlow" .. i
            s.Thickness = thickness
            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            s.LineJoinMode = Enum.LineJoinMode.Round
            s.Color = getMenuGlowStrokeColor(CurrentTheme)
            s.Transparency = transparency
            table.insert(getgenv().MenuChaseGlowStrokes, s)
        end
    else
        local layers = strong and 6 or 5
        local thickBase = strong and 0.65 or 0.5
        local thickStep = strong and 0.36 or 0.28
        local tBase = strong and 0.84 or 0.86
        local tStep = strong and 0.014 or 0.016
        for i = layers, 1, -1 do
            local s = Instance.new("UIStroke", target)
            s.Name = "MenuGlowLayer" .. i
            s.Thickness = thickBase + (layers - i) * thickStep
            s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
            s.LineJoinMode = Enum.LineJoinMode.Round
            s.Color = getMenuGlowStrokeColor(CurrentTheme)
            s.Transparency = tBase + (layers - i) * tStep
            table.insert(getgenv().MenuChaseGlowStrokes, s)
        end
    end
    local chase = Instance.new("UIStroke", target)
    chase.Name = "ChasingMenuStroke"
    local ch
    if type(oScale) == "number" and oScale > 0 then
        ch = (chaseThickness or 1.4) * (0.54 + 2.9 * oScale) * (strong and 1.05 or 1)
        if ch < 0.6 then
            ch = 0.6
        end
        if ch > 1.9 then
            ch = 1.9
        end
    else
        ch = (chaseThickness or 1.5) * (strong and 1.12 or 1)
    end
    chase.Thickness = ch
    chase.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    chase.LineJoinMode = Enum.LineJoinMode.Round
    chase.Transparency = 0
    chase.Color = Color3.new(1, 1, 1)
    local grad = Instance.new("UIGradient", chase)
    grad.Name = "ChaseGrad"
    grad.Color = getChaseColorSequenceForTheme(CurrentTheme, false)
    grad.Rotation = 0
    table.insert(destGradients, grad)
end

-- default outerScale 0.162; pass 0 for legacy multi-stroke only
local function addContentChaseGlow(target, thickness, strong, outerScale)
    if not target then
        return
    end
    getgenv().ContentChaseGradients = getgenv().ContentChaseGradients or {}
    if outerScale == nil then
        outerScale = 0.162
    end
    if outerScale == 0 or outerScale == false then
        addChasingMenuGlow(target, getgenv().ContentChaseGradients, thickness or 1.5, strong ~= false, nil)
    else
        addChasingMenuGlow(target, getgenv().ContentChaseGradients, thickness or 1.45, strong ~= false, outerScale)
    end
end

