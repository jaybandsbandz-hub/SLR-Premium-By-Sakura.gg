                    SetState("None")
                elseif i.KeyCode == Enum.KeyCode.F12 then
                    SetState("MouseButton4")
                elseif i.KeyCode == Enum.KeyCode.F11 then
                    SetState("MouseButton5")
                else
                    SetState(bindName)
                end
            end
        end)
    end)
