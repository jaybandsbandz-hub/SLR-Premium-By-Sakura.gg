local function GetItemMeta(name)
    local low = name:lower()
    if low:find("watch") or low:find("chain") or name == "Jewelry Box" then 
        return Color3.fromRGB(255, 210, 50), "[J]"
    elseif name == "Oil Barrel" or low == "oil" or low:find("crude oil") or low:find("oil barrel") then 
        return Color3.fromRGB(50, 150, 255), "[O]"
    elseif name == "RPG" then 
        return Color3.fromRGB(255, 0, 0), "[RPG]"
    elseif name == "Minigun" then 
        return Color3.fromRGB(255, 50, 50), "[M]"
    end
    return nil, nil
end

