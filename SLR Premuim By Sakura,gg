                conn:Disconnect()
                listening = false
                SetState("MouseButton5")
                return
            end
            
            local validInput = i.UserInputType == Enum.UserInputType.Keyboard
                or i.UserInputType == Enum.UserInputType.MouseButton1
                or i.UserInputType == Enum.UserInputType.MouseButton2
                or i.UserInputType == Enum.UserInputType.MouseButton3
                or SakuraInputIsGamepadType(i.UserInputType)
            if validInput then
