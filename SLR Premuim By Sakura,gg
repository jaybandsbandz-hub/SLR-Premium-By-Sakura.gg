-- One global InputChanged for all drags/resizes — avoids N permanent listeners (very laggy while moving the mouse).
local EliteDragState = { active = false, obj = nil, dragInput = nil, dragStart = nil, startPos = nil }
local EliteResizeState = { active = false, obj = nil, resStart = nil, startSize = nil }
local EliteGlobalDragResizeConn = nil
local function ensureEliteGlobalDragResizeConn()
    if EliteGlobalDragResizeConn then
        return
    end
    EliteGlobalDragResizeConn = Services.UIS.InputChanged:Connect(function(input)
        if EliteDragState.active and EliteDragState.dragInput and input == EliteDragState.dragInput then
            local delta = input.Position - EliteDragState.dragStart
            local obj = EliteDragState.obj
            if obj and obj.Parent then
                local sp = EliteDragState.startPos
                obj.Position = UDim2.new(sp.X.Scale, sp.X.Offset + delta.X, sp.Y.Scale, sp.Y.Offset + delta.Y)
            end
        elseif EliteResizeState.active and input.UserInputType == Enum.UserInputType.MouseMovement then
            local obj = EliteResizeState.obj
            if obj and obj.Parent then
                local deltaY = input.Position.Y - EliteResizeState.resStart.Y
                obj.Size = UDim2.new(0, obj.Size.X.Offset, 0, math.max(100, EliteResizeState.startSize + deltaY))
            end
        end
    end)
end

local function EnableDrag(obj, handle)
    ensureEliteGlobalDragResizeConn()
    handle.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        EliteDragState.active = true
        EliteDragState.obj = obj
        EliteDragState.dragStart = i.Position
        EliteDragState.startPos = obj.Position
        EliteDragState.dragInput = nil
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                EliteDragState.active = false
                EliteDragState.obj = nil
                EliteDragState.dragInput = nil
                task.delay(0.1, function()
                    if AutoSaveConfig then
                        AutoSaveConfig()
                    end
                end)
            end
        end)
    end)
    handle.InputChanged:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseMovement and EliteDragState.active and EliteDragState.obj == obj then
            EliteDragState.dragInput = i
        end
    end)
end

local function EnableVerticalResize(obj, handle)
    ensureEliteGlobalDragResizeConn()
    handle.InputBegan:Connect(function(i)
        if i.UserInputType ~= Enum.UserInputType.MouseButton1 then
            return
        end
        EliteResizeState.active = true
        EliteResizeState.obj = obj
        EliteResizeState.resStart = i.Position
        EliteResizeState.startSize = obj.Size.Y.Offset
        i.Changed:Connect(function()
            if i.UserInputState == Enum.UserInputState.End then
                EliteResizeState.active = false
                EliteResizeState.obj = nil
                task.delay(0.1, function()
                    if AutoSaveConfig then
                        AutoSaveConfig()
                    end
                end)
            end
        end)
    end)
end

