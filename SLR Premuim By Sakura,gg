            else
                local s1, obj1 = pcall(function() return Enum.KeyCode[keyName] end)
                local s2, obj2 = pcall(function() return Enum.UserInputType[keyName] end)
                if s1 and obj1 then 
                    parsedObj = obj1
                    displayName = obj1.Name
                elseif s2 and obj2 then 
