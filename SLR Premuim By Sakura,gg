-- Same hover feel as sidebar tabs / EliteLib rows (used for Spectate chrome + pop-out HUD).
local function wireMenuLikeHover(guiObject)
	if not guiObject or guiObject:GetAttribute("SakuraMenuHoverWired") then
		return
	end
	guiObject:SetAttribute("SakuraMenuHoverWired", true)
	guiObject.MouseEnter:Connect(function()
		local currentColor = guiObject.BackgroundColor3
		local currentTransparency = guiObject.BackgroundTransparency
		if CurrentTheme == "Sakura" then
			HoverTween(guiObject, { BackgroundColor3 = Color3.fromRGB(230, 230, 240) }):Play()
		else
			HoverTween(guiObject, { BackgroundTransparency = math.max(0, currentTransparency - 0.2) }):Play()
		end
		guiObject:SetAttribute("HoverOriginalColor", currentColor)
		guiObject:SetAttribute("HoverOriginalTransparency", currentTransparency)
	end)
	guiObject.MouseLeave:Connect(function()
		local originalColor = guiObject:GetAttribute("HoverOriginalColor")
		local originalTransparency = guiObject:GetAttribute("HoverOriginalTransparency")
		if CurrentTheme == "Sakura" and originalColor then
			HoverTween(guiObject, { BackgroundColor3 = originalColor }):Play()
		elseif originalTransparency then
			HoverTween(guiObject, { BackgroundTransparency = originalTransparency }):Play()
		end
	end)
end
