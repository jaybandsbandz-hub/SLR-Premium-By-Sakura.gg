local HUDAnimating = {}
-- Active pop-out tweens (cancel when menu shell forces a synced close, e.g. whitelist / chip mid-tween).
local HudPanelTween = setmetatable({}, { __mode = "k" })

local function cancelHudPanelTween(hud)
    if not hud then
        return
    end
    local tw = HudPanelTween[hud]
    if tw then
        pcall(function()
            tw:Cancel()
        end)
        HudPanelTween[hud] = nil
    end
end
-- Scanner inline chrome uses this; declared here so pop-out / menu guards can see it outside _initEliteFeatureSections.
local ScannerInlineAnimating = false
-- One duration for main shell, pop-outs, scanner chrome, watermark (same easing family = no “cheap” timing mismatch).
local MENU_UI_TWEEN = 0.68
local MENU_OPEN_TWEEN = MENU_UI_TWEEN
local MENU_CLOSE_TWEEN = MENU_UI_TWEEN
local PANEL_ANIM_DURATION = MENU_UI_TWEEN
-- Literal shared TweenInfo for menu shell + paired HUD tweens (same object = identical clock/easing to TweenService).
local TWEEN_SHELL_CLOSE = TweenInfo.new(MENU_CLOSE_TWEEN, Enum.EasingStyle.Quint, Enum.EasingDirection.In)
local TWEEN_SHELL_OPEN = TweenInfo.new(MENU_OPEN_TWEEN, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TWEEN_SHELL_OPEN_SHRINK = TweenInfo.new(MENU_OPEN_TWEEN, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

-- Pop-out close/open: snap pivot using screen-space math. Parent may be ScreenGui (GuiBase2d), not GuiObject.
local function hudSnapPivotToVisualCenter(hud)
    if not hud or not hud.Parent then
        return false
    end
    local parent = hud.Parent
    local absPos = hud.AbsolutePosition
    local absSize = hud.AbsoluteSize
    if absSize.X < 1 or absSize.Y < 1 then
        return false
    end
    local pAbs = Vector2.zero
    if parent:IsA("GuiBase2d") then
        pAbs = parent.AbsolutePosition
    end
    local cx = absPos.X + absSize.X * 0.5 - pAbs.X
    local cy = absPos.Y + absSize.Y * 0.5 - pAbs.Y
    hud.AnchorPoint = Vector2.new(0.5, 0.5)
    hud.Position = UDim2.fromOffset(cx, cy)
    return true
end

local function AnimateHUDOpen(hud, tweenInfoOverride)
    if not hud then
        return
    end
    if HudPanelTween[hud] then
        cancelHudPanelTween(hud)
        HUDAnimating[hud] = false
    end
    if HUDAnimating[hud] then
        return
    end
    if hud.Name == "SpectateHUD" and getgenv().LayoutSpectateHUD then
        pcall(getgenv().LayoutSpectateHUD)
    end
    HUDAnimating[hud] = true

    local originalSize = hud.Size
    local originalPos = hud.Position
    local originalAnchor = hud.AnchorPoint

    hud.ClipsDescendants = true
    if not hudSnapPivotToVisualCenter(hud) then
        hud.AnchorPoint = Vector2.new(0.5, 0.5)
        hud.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + originalSize.X.Offset / 2, originalPos.Y.Scale, originalPos.Y.Offset + originalSize.Y.Offset / 2)
    end
    hud.Size = UDim2.new(0, 0, 0, 0)
    hud.Visible = true

    local openTween = Services.Tween:Create(hud, tweenInfoOverride or TweenInfo.new(PANEL_ANIM_DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = originalSize })
    HudPanelTween[hud] = openTween
    openTween:Play()
    openTween.Completed:Connect(function(state)
        if state ~= nil and state ~= Enum.PlaybackState.Completed then
            if HudPanelTween[hud] == openTween then
                HudPanelTween[hud] = nil
            end
            return
        end
        if HudPanelTween[hud] == openTween then
            HudPanelTween[hud] = nil
        end
        hud.ClipsDescendants = false
        hud.AnchorPoint = originalAnchor
        hud.Position = originalPos
        HUDAnimating[hud] = false
    end)
end

local function AnimateHUDClose(hud, tweenInfoOverride, forceFromMenuShell)
    forceFromMenuShell = forceFromMenuShell == true
    if not hud or not hud.Visible then
        return
    end
    if HUDAnimating[hud] and not forceFromMenuShell then
        return
    end
    if forceFromMenuShell then
        cancelHudPanelTween(hud)
        HUDAnimating[hud] = false
    end
    HUDAnimating[hud] = true

    local originalSize = hud.Size
    local originalPos = hud.Position
    local originalAnchor = hud.AnchorPoint

    hud.ClipsDescendants = true
    if not hudSnapPivotToVisualCenter(hud) then
        hud.AnchorPoint = Vector2.new(0.5, 0.5)
        hud.Position = UDim2.new(originalPos.X.Scale, originalPos.X.Offset + hud.Size.X.Offset / 2, originalPos.Y.Scale, originalPos.Y.Offset + hud.Size.Y.Offset / 2)
    end

    local closeTween = Services.Tween:Create(hud, tweenInfoOverride or TweenInfo.new(PANEL_ANIM_DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.In), { Size = UDim2.new(0, 0, 0, 0) })
    HudPanelTween[hud] = closeTween
    closeTween:Play()
    closeTween.Completed:Connect(function(state)
        if state ~= nil and state ~= Enum.PlaybackState.Completed then
            if HudPanelTween[hud] == closeTween then
                HudPanelTween[hud] = nil
            end
            return
        end
        if HudPanelTween[hud] == closeTween then
            HudPanelTween[hud] = nil
        end
        hud.Visible = false
        hud.Size = originalSize
        hud.ClipsDescendants = false
        hud.AnchorPoint = originalAnchor
        hud.Position = originalPos
        HUDAnimating[hud] = false
    end)
end

