    tw.Completed:Connect(function()
        ScanDisplay.Visible = false
        ScanInlineScale.Scale = 1
        box.ClipsDescendants = false
        box.AnchorPoint = originalAnchor
        box.Position = originalPos
        ScannerInlineAnimating = false
