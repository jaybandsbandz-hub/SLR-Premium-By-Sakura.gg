    end

    pcall(function()
        getgenv().SakuraApplyServerBrowserTheme(CurrentTheme, Themes[CurrentTheme], (CurrentTheme == "Sakura" and Color3.new(1, 1, 1) or (CurrentTheme == "Galaxy" and Color3.fromRGB(24, 20, 40) or (CurrentTheme == "Lofi" and Color3.fromRGB(50, 24, 44) or Themes[CurrentTheme].Accent))))
