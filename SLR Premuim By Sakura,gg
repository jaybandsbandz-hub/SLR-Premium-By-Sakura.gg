-- Vertical scroll + engine smooth wheel (clients that support SmoothScroll / SmoothScrolling).
local function applySakuraScrollFrameFeel(scroll, opts)
	if not scroll or scroll.ClassName ~= "ScrollingFrame" then
		return
	end
	opts = opts or {}
	if opts.direction ~= nil then
		scroll.ScrollingDirection = opts.direction
	elseif scroll.ScrollingDirection == Enum.ScrollingDirection.XY then
		scroll.ScrollingDirection = Enum.ScrollingDirection.Y
	end
	if opts.elastic ~= nil then
		scroll.ElasticBehavior = opts.elastic
	end
	pcall(function()
		scroll.SmoothScroll = true
	end)
	pcall(function()
		scroll.SmoothScrolling = true
	end)
end

