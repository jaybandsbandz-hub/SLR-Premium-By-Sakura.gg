        elseif CurrentTheme == "Galaxy" then
            wlIconBadge.BackgroundColor3 = Color3.fromRGB(16, 14, 32)
            wlIcon.TextColor3 = Color3.fromRGB(200, 205, 220)
        elseif CurrentTheme == "Lofi" then
            wlIconBadge.BackgroundColor3 = Color3.fromRGB(40, 22, 40)
            wlIcon.TextColor3 = Color3.fromRGB(200, 205, 220)
        else
