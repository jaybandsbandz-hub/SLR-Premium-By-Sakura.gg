;(function() -- crypto / smart trader: own local scope (Luau ~200 locals per function)

local CRYPTO_HISTORY_LEN = 10
local CRYPTO_BUY_VS_MA = 0.992 
local CRYPTO_SELL_VS_MA = 1.012 
local CRYPTO_POLL_SEC = 0.35
local CRYPTO_REMOTE_GAP = 0.06

local priceHistory = {}
local lastRecordedPrice = 0
local myAverageBuyPrice = 0

-- Phone BTC: show "--" until first price change; then fixed 5m cycle, rolling forward after 0s until next change.
local CRYPTO_PHONE_TICK_SEC = 300
local cryptoUiLastPrice = nil
local cryptoUiLastChangeAt = nil
local cryptoUiPriceObjRef = nil

local function cryptoUiTickPrice(p, now)
	now = now or tick()
	local g = CRYPTO_PHONE_TICK_SEC
	if cryptoUiLastPrice == nil then
		cryptoUiLastPrice = p
		cryptoUiLastChangeAt = nil
		return nil
	end
	if p ~= cryptoUiLastPrice then
		cryptoUiLastChangeAt = now
		cryptoUiLastPrice = p
	end
	if cryptoUiLastChangeAt == nil then
		return nil
	end
	local nextAt = cryptoUiLastChangeAt + g
	while nextAt <= now do
		nextAt += g
	end
	return nextAt - now
end

local function updateCryptoLabels(price, owned, cycleSecs)
    local colorStr = getgenv().CryptoNumberColor or "rgb(255,255,255)"
    
    if getgenv().CryptoPriceLabel then
        getgenv().CryptoPriceLabel.Text = "Live BTC: <font color='" .. colorStr .. "'>$" .. tostring(price) .. "</font>"
    end
    if getgenv().CryptoWalletLabel then
        getgenv().CryptoWalletLabel.Text = "Wallet: " .. tostring(owned) .. " / 20 BTC"
    end
    if getgenv().CryptoLifetimeLabel then
        getgenv().CryptoLifetimeLabel.Text = "Lifetime Profit: <font color='" .. colorStr .. "'>$" .. tostring(math.floor(getgenv().LifetimeCryptoProfit or 0)) .. "</font>"
    end
    if getgenv().CryptoProfitLabel then
        getgenv().CryptoProfitLabel.Text = "Session Profit: <font color='" .. colorStr .. "'>$" .. tostring(math.floor(getgenv().SessionCryptoProfit or 0)) .. "</font>"
    end
    if getgenv().CryptoCycleLabel then
        if type(cycleSecs) == "number" then
            local t = math.max(0, math.floor(cycleSecs))
            local line
            if t <= 59 then
                line = "Price Change: " .. tostring(t) .. "s"
            else
                local m = math.floor(t / 60)
                local s = t % 60
                if s == 0 then
                    line = "Price Change: " .. tostring(m) .. "m"
                else
                    line = "Price Change: " .. tostring(m) .. "m " .. tostring(s) .. "s"
                end
            end
            getgenv().CryptoCycleLabel.Text = line
        else
            getgenv().CryptoCycleLabel.Text = "Price Change: --"
        end
    end
end

local function ensureCryptoUiPriceListener(currentBtcPriceObj)
	if not currentBtcPriceObj or not currentBtcPriceObj:IsA("ValueBase") then
		return
	end
	if cryptoUiPriceObjRef ~= currentBtcPriceObj then
		local old = getgenv().CryptoUiPriceConn
		if old then
			pcall(function()
				old:Disconnect()
			end)
			getgenv().CryptoUiPriceConn = nil
		end
		cryptoUiPriceObjRef = currentBtcPriceObj
	end
	if getgenv().CryptoUiPriceConn then
		return
	end
	local obj = cryptoUiPriceObjRef
	getgenv().CryptoUiPriceConn = obj:GetPropertyChangedSignal("Value"):Connect(function()
		pcall(function()
			if getgenv().EliteHubV2_Shutdown then
				return
			end
			local now = tick()
			local pv = obj.Value
			local cycleSecs = cryptoUiTickPrice(pv, now)
			local myData = Services.Players.LocalPlayer:FindFirstChild("Data")
			local myBtcBalanceObj = myData and myData:FindFirstChild("Crypto")
			if myBtcBalanceObj and getgenv().CryptoPriceLabel then
				updateCryptoLabels(pv, myBtcBalanceObj.Value, cycleSecs)
			end
		end)
	end)
end

local function handleSmartCryptoTrader()
    local repStorage = game:GetService("ReplicatedStorage")
    local phoneMisc = repStorage:FindFirstChild("Misc") and repStorage.Misc:FindFirstChild("Phone")
    local currentBtcPriceObj = phoneMisc and phoneMisc:FindFirstChild("Crypto")
    local myData = Services.Players.LocalPlayer:FindFirstChild("Data")
    local myBtcBalanceObj = myData and myData:FindFirstChild("Crypto")
    local myBankBalanceObj = myData and myData:FindFirstChild("Bank")
    local phoneRemote = repStorage:FindFirstChild("Remotes") and repStorage.Remotes:FindFirstChild("Phone")

    local cycleSecs = nil
    if currentBtcPriceObj then
        ensureCryptoUiPriceListener(currentBtcPriceObj)
        cycleSecs = cryptoUiTickPrice(currentBtcPriceObj.Value, tick())
    end

    if currentBtcPriceObj and myBtcBalanceObj then
        updateCryptoLabels(currentBtcPriceObj.Value, myBtcBalanceObj.Value, cycleSecs)
    end

    if not getgenv().AutoCrypto then
        return
    end

    if not (currentBtcPriceObj and myBtcBalanceObj and myBankBalanceObj and phoneRemote) then
        return
    end

    local currentPrice = currentBtcPriceObj.Value
    local myBtc = myBtcBalanceObj.Value
    local myBank = myBankBalanceObj.Value

    if currentPrice ~= lastRecordedPrice then
        lastRecordedPrice = currentPrice
        table.insert(priceHistory, currentPrice)
        if #priceHistory > CRYPTO_HISTORY_LEN then table.remove(priceHistory, 1) end

        local sum = 0
        for _, ph in ipairs(priceHistory) do sum = sum + ph end
        local marketAverage = #priceHistory > 0 and (sum / #priceHistory) or currentPrice
        local buyTarget = math.floor(marketAverage * CRYPTO_BUY_VS_MA)
        local sellTarget = math.floor(marketAverage * CRYPTO_SELL_VS_MA)

        if myBtc > 0 and myAverageBuyPrice == 0 then
            myAverageBuyPrice = 1
        elseif myBtc == 0 then
            myAverageBuyPrice = 0
        end

        local isDip = currentPrice <= buyTarget
        if isDip and myBank >= currentPrice and myBtc < 20 then
            local maxCanAfford = math.floor(myBank / currentPrice)
            local spaceInWallet = 20 - myBtc
            local amountToBuy = math.min(maxCanAfford, spaceInWallet)

            if amountToBuy > 0 then
                for i = 1, amountToBuy do
                    phoneRemote:FireServer("Crypto", "Purchase", currentPrice)
                    task.wait(CRYPTO_REMOTE_GAP)
                end

                if myBtc == 0 then
                    myAverageBuyPrice = currentPrice
                else
                    myAverageBuyPrice = ((myAverageBuyPrice * myBtc) + (currentPrice * amountToBuy)) / (myBtc + amountToBuy)
                end
                SakuraNotify("Crypto", string.format("Bought %d BTC at $%s", amountToBuy, tostring(math.floor(currentPrice))), 4)
            end
        end

        local isPeak = currentPrice >= sellTarget
        local isProfitable = currentPrice > myAverageBuyPrice

        if myBtc > 0 and isPeak and isProfitable then
            local profitPerBtc = currentPrice - myAverageBuyPrice
            local gain = profitPerBtc * myBtc
            local btcSold = myBtc
            getgenv().SessionCryptoProfit = (getgenv().SessionCryptoProfit or 0) + gain
            getgenv().LifetimeCryptoProfit = (getgenv().LifetimeCryptoProfit or 0) + gain
            saveLifetimeCryptoProfit()
            local cycleFresh = currentBtcPriceObj and cryptoUiTickPrice(currentBtcPriceObj.Value, tick())
            updateCryptoLabels(currentPrice, myBtcBalanceObj.Value, cycleFresh)

            for i = 1, myBtc do
                phoneRemote:FireServer("Crypto", "Sell", currentPrice)
                task.wait(CRYPTO_REMOTE_GAP)
            end
            SakuraNotify("Crypto", string.format("Sold %d BTC — est. profit $%s", btcSold, tostring(math.floor(gain))), 4)
        end
    end
end

task.spawn(function()
    while not getgenv().EliteHubV2_Shutdown do
        task.wait(CRYPTO_POLL_SEC)
        pcall(handleSmartCryptoTrader)
    end
end)

end)()

