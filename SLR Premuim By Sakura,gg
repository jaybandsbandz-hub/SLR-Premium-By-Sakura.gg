local function RunScanner()
    ClearScannerDisplays()

    local foundData = {}
    
    for _, p in pairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer then
            local pItems = {}
            
            if p:FindFirstChild("Backpack") then 
                for _, i in pairs(p.Backpack:GetChildren()) do 
                    local col, tag = GetItemMeta(i.Name)
                    if col then table.insert(pItems, {Name = i.Name, Tag = tag, Color = col}) end
                end
            end
            
            if p.Character and p.Character:FindFirstChildOfClass("Tool") then 
                local tool = p.Character:FindFirstChildOfClass("Tool")
                local col, tag = GetItemMeta(tool.Name)
                if col then table.insert(pItems, {Name = tool.Name, Tag = tag, Color = col}) end
            end

            if #pItems > 0 then
                local location = "Unknown"
                if p.Character and p.Character:FindFirstChild("HumanoidRootPart") then 
                    location = GetNearestLocation(p.Character.HumanoidRootPart.Position)
                end
                
                local counts = {}
                local uniques = {}
                for _, item in ipairs(pItems) do
                    local key = item.Tag .. item.Name
                    if not counts[key] then
                        counts[key] = {count = 1, tag = item.Tag, name = item.Name, color = item.Color}
                        table.insert(uniques, key)
                    else
                        counts[key].count = counts[key].count + 1
                    end
                end
                
                local groupedItems = {}
                for _, key in ipairs(uniques) do
                    local data = counts[key]
                    local displayText = data.tag .. " " .. data.name
                    if data.count > 1 then
                        displayText = displayText .. " (x" .. data.count .. ")"
                    end
                    table.insert(groupedItems, {Text = displayText, Color = data.color})
                end
                
                table.insert(foundData, {Name = p.Name, Location = location, Items = groupedItems})
            end
        end
    end

