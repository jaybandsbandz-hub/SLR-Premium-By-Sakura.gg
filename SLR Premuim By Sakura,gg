local SakuraAimPickRayParams = RaycastParams.new()
SakuraAimPickRayParams.FilterType = Enum.RaycastFilterType.Blacklist
SakuraAimPickRayParams.IgnoreWater = true

-- Returns best player and their world / screen distance to crosshair (for NPC+player resolution).
local function computeBestPlayerAimPick()
    local Camera = workspace.CurrentCamera
    if not Camera then
        return nil, math.huge, math.huge
    end
    if not IsAimbotInteractionAllowed() then
        return nil, math.huge, math.huge
    end

    local bestPlayer = nil
    local bestScreenDist = math.huge
    local bestWorldDist = math.huge
    local winWorld = math.huge
    local winScreen = math.huge

    local targetPart = (Settings.Aim and Settings.Aim.Part) or "Head"
    local mousePos = Services.UIS:GetMouseLocation()
    local fovRadius = (Settings.Fov and Settings.Fov.Size) or 0
    local md = Settings.Aim and Settings.Aim.MaxDistance
    local maxDistance = (md == nil) and 1000 or md
    local prioritizeWorld = AimPrioritizeWorldDistance()
    local visibleCheck = Settings.Aim and Settings.Aim.VisibleCheck
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, p in ipairs(Services.Players:GetPlayers()) do
        if p ~= LocalPlayer and not WhitelistedPlayers[p.Name] and p.Character and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
            local targetHRP = p.Character:FindFirstChild("HumanoidRootPart")
            local aimPart = p.Character:FindFirstChild(targetPart)

            if not aimPart then
                if targetPart == "UpperTorso" or targetPart == "LowerTorso" then
                    aimPart = p.Character:FindFirstChild("Torso") or p.Character:FindFirstChild("UpperTorso")
                elseif targetPart == "Torso" then
                    aimPart = p.Character:FindFirstChild("UpperTorso") or p.Character:FindFirstChild("Torso")
                end
            end

            if targetHRP and aimPart and myHRP then
                local worldDistance = (targetHRP.Position - myHRP.Position).Magnitude
                if maxDistance <= 0 or worldDistance <= maxDistance then
                    local pos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                    if onScreen then
                        local screenDist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                        if fovRadius == 0 or screenDist <= fovRadius then
                            local blocked = false
                            if visibleCheck and myChar then
                                local rayOrigin = Camera.CFrame.Position
                                local rayLen = (aimPart.Position - rayOrigin).Magnitude
                                if rayLen > 0.05 then
                                    local rayDir = (aimPart.Position - rayOrigin).Unit * rayLen
                                    SakuraAimPickRayParams.FilterDescendantsInstances = { myChar, p.Character }
                                    if workspace:Raycast(rayOrigin, rayDir, SakuraAimPickRayParams) then
                                        blocked = true
                                    end
                                end
                            end
                            if not blocked then
                                if prioritizeWorld then
                                    if worldDistance < bestWorldDist then
                                        bestWorldDist = worldDistance
                                        bestPlayer = p
                                        winWorld = worldDistance
                                        winScreen = screenDist
                                    end
                                else
                                    if screenDist < bestScreenDist then
                                        bestScreenDist = screenDist
                                        bestPlayer = p
                                        winWorld = worldDistance
                                        winScreen = screenDist
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestPlayer then
        return nil, math.huge, math.huge
    end
    return bestPlayer, winWorld, winScreen
end

local function GetClosestTarget()
    local p, _, _ = computeBestPlayerAimPick()
    return p
end

