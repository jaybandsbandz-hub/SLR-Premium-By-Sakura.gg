        pcall(function()
            local c = TargetParent:FindFirstChild("CatfishDecoy")
            if c then c:Destroy() end
        end)
    end
    local theme = Themes[name]; if not theme then return end
    if tabsOnly then
        for n, t in pairs(Tabs) do
            local isActive = (n == CurrentTab)
            if t.Stroke then
                t.Stroke.Transparency = 1
            end
