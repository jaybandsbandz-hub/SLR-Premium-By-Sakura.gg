local function ensureNpcAimCandidateList()
    if not (Settings.Aim and Settings.Aim.NpcAimbot) then
        return
    end
    if os.clock() < npcAimCandidateListExpire then
        return
    end
    npcAimCandidateListExpire = os.clock() + NPC_AIM_CACHE_TTL
    local list = {}
    local myHrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local md = Settings.Aim and Settings.Aim.MaxDistance
    local capDist = (md and md > 0) and math.min(md + 200, 900) or 450
    for _, inst in ipairs(workspace:GetDescendants()) do
        if inst:IsA("Model") then
            local hum = inst:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and inst:FindFirstChild("Head") and Services.Players:GetPlayerFromCharacter(inst) == nil then
                if myHrp then
                    local root = inst:FindFirstChild("HumanoidRootPart") or inst.PrimaryPart or inst:FindFirstChild("Head")
                    if root and (root.Position - myHrp.Position).Magnitude <= capDist then
                        table.insert(list, inst)
                    end
                end
            end
        end
    end
    npcAimCandidateList = list
end

local function computeBestNpcAimPick()
    local Camera = workspace.CurrentCamera
    if not Camera then
        return nil, math.huge, math.huge
    end
    if not IsAimbotInteractionAllowed() then
        return nil, math.huge, math.huge
    end
    if not (Settings.Aim and Settings.Aim.NpcAimbot) then
        return nil, math.huge, math.huge
    end

    ensureNpcAimCandidateList()

    local bestModel = nil
    local bestScreenDist = math.huge
    local bestWorldDist = math.huge
    local winWorld = math.huge
    local winScreen = math.huge

    local mousePos = Services.UIS:GetMouseLocation()
    local fovRadius = (Settings.Fov and Settings.Fov.Size) or 0
    local md = Settings.Aim and Settings.Aim.MaxDistance
    local maxDistance = (md == nil) and 1000 or md
    local prioritizeWorld = AimPrioritizeWorldDistance()
    local visibleCheck = Settings.Aim and Settings.Aim.VisibleCheck
    local myChar = LocalPlayer.Character
    local myHRP = myChar and myChar:FindFirstChild("HumanoidRootPart")

    for _, model in ipairs(npcAimCandidateList) do
        if model.Parent then
            local hum = model:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 and Services.Players:GetPlayerFromCharacter(model) == nil then
                local aimPart = model:FindFirstChild("Head")
                local targetHRP = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart or aimPart
                if targetHRP and aimPart and myHRP then
                    local worldDistance = (targetHRP.Position - myHRP.Position).Magnitude
                    if maxDistance <= 0 or worldDistance <= maxDistance then
                        local pos, onScreen = Camera:WorldToViewportPoint(aimPart.Position)
                        if onScreen then
                            local screenDist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                            if fovRadius == 0 or screenDist <= fovRadius then
                                local blocked = false
                                if visibleCheck and myChar then
                                    local rayOrigin = Camera.CFrame.Position
                                    local rayLen = (aimPart.Position - rayOrigin).Magnitude
                                    if rayLen > 0.05 then
                                        local rayDir = (aimPart.Position - rayOrigin).Unit * rayLen
                                        SakuraAimPickRayParams.FilterDescendantsInstances = { myChar, model }
                                        if workspace:Raycast(rayOrigin, rayDir, SakuraAimPickRayParams) then
                                            blocked = true
                                        end
                                    end
                                end
                                if not blocked then
                                    if prioritizeWorld then
                                        if worldDistance < bestWorldDist then
                                            bestWorldDist = worldDistance
                                            bestModel = model
                                            winWorld = worldDistance
                                            winScreen = screenDist
                                        end
                                    else
                                        if screenDist < bestScreenDist then
                                            bestScreenDist = screenDist
                                            bestModel = model
                                            winWorld = worldDistance
                                            winScreen = screenDist
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
    end
    if not bestModel then
        return nil, math.huge, math.huge
    end
    return bestModel, winWorld, winScreen
end

-- When NPC aimbot is on: pick NPC unless a player is in the same FOV and within world-distance vicinity, then player wins.
local function ResolveNpcAimLockedCharacter()
    if not (Settings.Aim and Settings.Aim.NpcAimbot) then
        return nil
    end
    local plr, pW, pS = computeBestPlayerAimPick()
    local npc, nW, nS = computeBestNpcAimPick()
    local charPlr = plr and plr.Character or nil
    if charPlr and npc then
        if math.abs(pW - nW) <= NPC_PLAYER_WORLD_VICINITY then
            return charPlr
        end
        local prioritizeWorld = AimPrioritizeWorldDistance()
        if prioritizeWorld then
            return (pW <= nW) and charPlr or npc
        else
            return (pS <= nS) and charPlr or npc
        end
    end
    return charPlr or npc
end

