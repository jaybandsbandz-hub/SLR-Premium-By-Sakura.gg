do
local dir = ConfigFolder .. "/profiles"
local legacyJson = ConfigFolder .. "/profiles.json"
local P = {}

P.normPath = function(p)
    return (p or ""):gsub("\\", "/"):lower()
end

P.fsPath = function(p)
    return (p or ""):gsub("\\", "/")
end

P.resolvePath = function(f)
    if type(f) ~= "string" then return nil end
    if f:find("/") or f:find("\\") then return f end
    return dir .. "/" .. f
end

P.esc = function(s)
    if s == nil then return "" end
    return tostring(s):gsub("\\", "\\\\"):gsub("\n", "\\n")
end

P.unesc = function(s)
    return (s or ""):gsub("\\n", "\n"):gsub("\\\\", "\\")
end

P.serialize = function(data, profileName)
    local lines = {}
    table.insert(lines, "# SakuraGGProfile v1")
    table.insert(lines, "# profile=" .. P.esc(profileName))
    table.insert(lines, "[whitelist]")
    if data.Whitelist then
        for _, n in ipairs(data.Whitelist) do
            table.insert(lines, P.esc(n))
        end
    end
    table.insert(lines, "[flags]")
    for k, v in pairs(data) do
        if k ~= "Whitelist" then
            local t = type(v)
            if t == "boolean" then
                table.insert(lines, k .. "=" .. (v and "true" or "false"))
            elseif t == "number" then
                table.insert(lines, k .. "=" .. tostring(v))
            elseif t == "string" then
                table.insert(lines, k .. "=" .. P.esc(v))
            end
        end
    end
    return table.concat(lines, "\n")
end

P.deserialize = function(raw)
    local data = { Whitelist = {} }
    local profileName = nil
    local section = "none"
    for line in raw:gmatch("[^\r\n]+") do
        line = line:match("^%s*(.-)%s*$") or ""
        local pn = line:match("^#%s*profile=(.+)$")
        if pn then
            profileName = P.unesc(pn)
        elseif line == "" or line:sub(1, 1) == "#" then
        elseif line == "[whitelist]" then
            section = "whitelist"
        elseif line == "[flags]" then
            section = "flags"
        elseif section == "whitelist" and line ~= "" then
            table.insert(data.Whitelist, P.unesc(line))
        elseif section == "flags" then
            local eq = line:find("=", 1, true)
            if eq then
                local key = line:sub(1, eq - 1):match("^%s*(.-)%s*$")
                local val = line:sub(eq + 1):match("^%s*(.-)%s*$")
                if key and val ~= nil then
                    if val == "true" then
                        data[key] = true
                    elseif val == "false" then
                        data[key] = false
                    else
                        local n = tonumber(val)
                        if n ~= nil then
                            data[key] = n
                        else
                            data[key] = P.unesc(val)
                        end
                    end
                end
            end
        end
    end
    return data, profileName
end

P.diskPath = function(name)
    local safe = name:gsub("[^%w%-_]", "_"):gsub("_+", "_"):sub(1, 64)
    if safe == "" then safe = "profile" end
    return P.fsPath(dir .. "/" .. safe .. ".txt")
end

-- Read a profile table from disk (multiple path shapes; some executors normalize paths differently).
P.readProfileDataFromDisk = function(profileName)
    if type(profileName) ~= "string" or profileName == "" then
        return nil
    end
    local safe = profileName:gsub("[^%w%-_]", "_"):gsub("_+", "_"):sub(1, 64)
    if safe == "" then
        safe = "profile"
    end
    local candidates = {
        P.diskPath(profileName),
        ConfigFolder .. "/profiles/" .. safe .. ".txt",
        ConfigFolder .. "\\profiles\\" .. safe .. ".txt",
    }
    for _, p in ipairs(candidates) do
        if type(p) == "string" and p ~= "" then
            local okR, raw = pcall(function()
                if not isfile(p) then
                    return nil
                end
                return readfile(p)
            end)
            if okR and type(raw) == "string" and raw ~= "" then
                local okDec, pdata = pcall(function()
                    return select(1, P.deserialize(raw))
                end)
                if okDec and type(pdata) == "table" then
                    return pdata
                end
            end
        end
    end
    return nil
end

-- Legacy profiles.json re-imports every key on each run; remove the name or the
-- deleted profile will be recreated from JSON even when its .txt was removed.
P.removeFromLegacyJson = function(profileName)
    if type(profileName) ~= "string" or profileName == "" then
        return
    end
    pcall(function()
        if not isfile(legacyJson) then
            return
        end
        local raw = readfile(legacyJson)
        if type(raw) ~= "string" or raw == "" then
            return
        end
        local ok, dec = pcall(function()
            return Services.Http:JSONDecode(raw)
        end)
        if not ok or type(dec) ~= "table" or dec[profileName] == nil then
            return
        end
        dec[profileName] = nil
        local remaining = 0
        for _ in pairs(dec) do
            remaining = remaining + 1
        end
        if remaining == 0 then
            pcall(function()
                delfile(legacyJson)
            end)
        else
            local okEnc, encoded = pcall(function()
                return Services.Http:JSONEncode(dec)
            end)
            if okEnc and type(encoded) == "string" then
                writefile(legacyJson, encoded)
            end
        end
    end)
end

P.deleteProfileFromDisk = function(profileName)
    if type(profileName) ~= "string" or profileName == "" then
        return
    end
    local safeFromKey = profileName:gsub("[^%w%-_]", "_"):gsub("_+", "_"):sub(1, 64)
    if safeFromKey == "" then
        safeFromKey = "profile"
    end
    local candidates = {}
    local function addPath(p)
        if type(p) ~= "string" or p == "" then
            return
        end
        local n = P.fsPath(p)
        candidates[n] = true
        candidates[n:gsub("/", "\\")] = true
    end
    addPath(P.diskPath(profileName))
    addPath(ConfigFolder .. "/profiles/" .. safeFromKey .. ".txt")
    addPath(ConfigFolder .. "\\profiles\\" .. safeFromKey .. ".txt")
    for p in pairs(candidates) do
    pcall(function()
            if isfile(p) then
                delfile(p)
            end
        end)
    end
    local function fileMatchesContent(path, raw)
        if type(raw) ~= "string" or raw == "" then
            return false
        end
        local okDec, _, pname = pcall(P.deserialize, raw)
        local stem = path:match("([^/\\]+)%.[tT][xX][tT]$")
        if stem then
            stem = stem:gsub("%.txt$", ""):gsub("%.TXT$", "")
        end
        local matchName = okDec and pname == profileName
        local matchStem = stem == safeFromKey or stem == profileName
        return matchName or matchStem
    end
    local function tryRead(path)
        local rawOk, raw = pcall(function()
            return readfile(path)
        end)
        return rawOk, raw
    end
    local function deleteIfMatch(canonicalPath, altPath)
        if type(canonicalPath) ~= "string" or not canonicalPath:lower():match("%.txt$") then
            return
        end
        local rawOk, raw = tryRead(canonicalPath)
        if (not rawOk or type(raw) ~= "string" or raw == "") and altPath and altPath ~= canonicalPath then
            rawOk, raw = tryRead(altPath)
            canonicalPath = altPath
        end
        if rawOk and type(raw) == "string" and raw ~= "" and fileMatchesContent(canonicalPath, raw) then
            pcall(function()
                if isfile(canonicalPath) then
                    delfile(canonicalPath)
                end
            end)
        end
    end
    pcall(function()
        P.ensureDir()
        local files = listfiles(dir)
        if type(files) == "table" then
        for _, f in ipairs(files) do
                if type(f) == "string" then
                    local resolved = P.resolvePath(f)
                    deleteIfMatch(f, resolved)
                    if resolved and resolved ~= f then
                        deleteIfMatch(resolved, f)
                    end
                end
            end
        end
        local alt = listfiles(ConfigFolder)
        if type(alt) == "table" then
            for _, f in ipairs(alt) do
                if type(f) == "string" and f:gsub("\\", "/"):lower():find("/profiles/", 1, true) and f:lower():match("%.txt$") then
                    local resolved = P.resolvePath(f)
                    deleteIfMatch(f, resolved)
                    if resolved and resolved ~= f then
                        deleteIfMatch(resolved, f)
                    end
                end
            end
        end
    end)
    -- Final sweep: some executors use odd casing (Profiles vs profiles) or only return basenames;
    -- delete any .txt in the profiles folder whose stem or # profile= matches this profile.
    pcall(function()
        P.ensureDir()
        local wantStem = safeFromKey:lower()
        local wantName = profileName:lower()
        local lf = listfiles(dir)
        if type(lf) ~= "table" then
            return
        end
        for _, f in ipairs(lf) do
            if type(f) == "string" then
            local paths = { f }
            local r = P.resolvePath(f)
            if r and r ~= f then
                table.insert(paths, r)
            end
            for _, path in ipairs(paths) do
                if type(path) == "string" and path:lower():match("%.txt$") and isfile(path) then
                    local stem = path:match("([^/\\]+)%.[tT][xX][tT]$")
                    if stem then
                        stem = stem:gsub("%.txt$", ""):gsub("%.TXT$", ""):lower()
                    end
                    local hit = stem and (stem == wantStem or stem == wantName)
                    if not hit then
                        local okR, raw = pcall(function()
                            return readfile(path)
                        end)
                        if okR and type(raw) == "string" and raw ~= "" then
                            local okD, _, pn = pcall(P.deserialize, raw)
                            if okD and type(pn) == "string" and pn == profileName then
                                hit = true
                            end
                        end
                    end
                    if hit then
                        pcall(function()
                            if isfile(path) then
                                delfile(path)
                            end
                        end)
                    end
                end
            end
            end
        end
    end)
    P.removeFromLegacyJson(profileName)
    pcall(function()
        P.addProfileDeleteTombstone(profileName)
    end)
end

P.ensureDir = function()
    pcall(function()
        if not isfolder(dir) then makefolder(dir) end
    end)
end

P.safeStemForName = function(name)
    local safe = name:gsub("[^%w%-_]", "_"):gsub("_+", "_"):sub(1, 64)
    if safe == "" then
        safe = "profile"
    end
    return safe
end

-- Persist deleted profile keys so stray .txt files or re-ingest cannot resurrect them after re-execute.
P.getDeletedProfileKeysSet = function()
    local set = {}
    pcall(function()
        P.ensureDir()
        local tombPath = ConfigFolder .. "/deleted_profiles.txt"
        if not isfile(tombPath) then
            return
        end
        local body = readfile(tombPath)
        if type(body) ~= "string" or body == "" then
            return
        end
        for line in body:gmatch("[^\r\n]+") do
            local t = line:match("^%s*(.-)%s*$") or ""
            if t ~= "" then
                set[t:lower()] = true
            end
        end
    end)
    return set
end

P.addProfileDeleteTombstone = function(profileName)
    if type(profileName) ~= "string" or profileName == "" then
        return
    end
    pcall(function()
        P.ensureDir()
        local tombPath = ConfigFolder .. "/deleted_profiles.txt"
        local set = {}
        if isfile(tombPath) then
            local body = readfile(tombPath)
            if type(body) == "string" and body ~= "" then
                for line in body:gmatch("[^\r\n]+") do
                    local t = line:match("^%s*(.-)%s*$") or ""
                    if t ~= "" then
                        set[t:lower()] = true
                    end
                end
            end
        end
        set[profileName:lower()] = true
        set[P.safeStemForName(profileName):lower()] = true
        local keys = {}
        for k in pairs(set) do
            table.insert(keys, k)
        end
        table.sort(keys)
        writefile(tombPath, (#keys > 0 and table.concat(keys, "\n") .. "\n" or ""))
    end)
end

P.removeProfileDeleteTombstone = function(profileName)
    if type(profileName) ~= "string" or profileName == "" then
        return
    end
    pcall(function()
        local tombPath = ConfigFolder .. "/deleted_profiles.txt"
        if not isfile(tombPath) then
            return
        end
        local drop = {}
        drop[profileName:lower()] = true
        drop[P.safeStemForName(profileName):lower()] = true
        local kept = {}
        local body = readfile(tombPath)
        if type(body) == "string" and body ~= "" then
            for line in body:gmatch("[^\r\n]+") do
                local t = line:match("^%s*(.-)%s*$") or ""
                if t ~= "" and not drop[t:lower()] then
                    table.insert(kept, t:lower())
                end
            end
        end
        if #kept == 0 then
            pcall(function()
                delfile(tombPath)
            end)
        else
            table.sort(kept)
            writefile(tombPath, table.concat(kept, "\n") .. "\n")
        end
    end)
end

P.isOurProfileFormat = function(raw)
    return type(raw) == "string"
        and (raw:find("SakuraGGProfile", 1, true) or raw:find("# profile=", 1, true))
end

P.profileIdentityFromFile = function(pathForStem, raw)
    if not P.isOurProfileFormat(raw) then
        return nil
    end
    local okDec, _, pname = pcall(P.deserialize, raw)
    if okDec and type(pname) == "string" and pname ~= "" then
        return pname
    end
    local stem = pathForStem:match("([^/\\]+)%.[tT][xX][tT]$")
    if stem then
        stem = stem:gsub("%.txt$", ""):gsub("%.TXT$", "")
    end
    if stem and stem ~= "" then
        return stem
    end
    return nil
end

-- Delete profile .txt files on disk that are not in allowedNames (same keys as `profiles`).
P.pruneProfilesDisk = function(allowedNames)
    if type(allowedNames) ~= "table" then
        return
    end
    local allowedStems = {}
    for n in pairs(allowedNames) do
        if type(n) == "string" and n ~= "" then
            allowedStems[P.safeStemForName(n)] = true
        end
    end
    local function pathVariants(f)
        local v = { f }
        local r = P.resolvePath(f)
        if r and r ~= f then
            table.insert(v, r)
        end
        table.insert(v, P.fsPath(f))
        if r then
            table.insert(v, r:gsub("/", "\\"))
        end
        table.insert(v, f:gsub("/", "\\"))
        return v
    end
    local function isProfilesTxtPath(p)
        if type(p) ~= "string" or not p:lower():match("%.txt$") then
            return false
        end
        local n = p:gsub("\\", "/"):lower()
        return n:find("/profiles/", 1, true) ~= nil
    end
    local function considerFileRef(f)
        if type(f) ~= "string" then
            return
        end
        local resolved = P.resolvePath(f) or f
        if not isProfilesTxtPath(resolved) and not isProfilesTxtPath(f) then
            return
        end
        local variants = pathVariants(f)
        local raw = nil
        local pathUsed = nil
        for _, p in ipairs(variants) do
            if type(p) == "string" and p ~= "" then
                local okR, body = pcall(function()
                    return readfile(p)
                end)
                if okR and type(body) == "string" and body ~= "" then
                    raw = body
                    pathUsed = p
                    break
                end
            end
        end
        local stem = (resolved:match("([^/\\]+)%.[tT][xX][tT]$") or f:match("([^/\\]+)%.[tT][xX][tT]$") or "")
        if stem ~= "" then
            stem = stem:gsub("%.txt$", ""):gsub("%.TXT$", "")
        end
        local drop = false
                if raw and raw ~= "" then
            if P.isOurProfileFormat(raw) then
                local id = P.profileIdentityFromFile(pathUsed or resolved, raw)
                if id and not allowedNames[id] then
                    drop = true
                end
            end
        else
            if stem ~= "" and not allowedStems[stem] then
                drop = true
            end
        end
        if not drop then
            return
        end
        for _, p in ipairs(variants) do
            pcall(function()
                if type(p) == "string" and p ~= "" and isfile(p) then
                    delfile(p)
                end
            end)
        end
    end
    pcall(function()
        P.ensureDir()
        local lists = { listfiles(dir), listfiles(ConfigFolder) }
        for _, files in ipairs(lists) do
            if type(files) == "table" then
                for _, f in ipairs(files) do
                    considerFileRef(f)
                end
                for k, f in pairs(files) do
                    if (type(k) ~= "number" or k < 1 or k > #files) and type(f) == "string" then
                        considerFileRef(f)
                    end
                end
            end
        end
    end)
end

P.loadAll = function()
    local out = {}
    P.ensureDir()
    local deletedSet = P.getDeletedProfileKeysSet()

    local function tombstoneMatches(key, pname, path)
        if not next(deletedSet) then
            return false
        end
        local candidates = {}
        local function add(s)
            if type(s) ~= "string" or s == "" then
                return
            end
            candidates[s:lower()] = true
            candidates[P.safeStemForName(s):lower()] = true
        end
        add(key)
        add(pname)
        if type(path) == "string" then
            local stem = path:match("([^/\\]+)%.[tT][xX][tT]$")
            if stem then
                stem = stem:gsub("%.txt$", ""):gsub("%.TXT$", "")
                add(stem)
            end
        end
