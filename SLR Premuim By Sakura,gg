			streamCharConn = nil
		end
	end

	local function clearStreamingFocus()
		task.spawn(function()
			pcall(function()
				LocalPlayer.ReplicationFocus = nil
			end)
		end)
	end

	local function tryImproveStreamingAroundCharacter(char)
		if not char then
			return
		end
		local hrp = char:FindFirstChild("HumanoidRootPart")
		if not hrp or not hrp:IsA("BasePart") then
			return
		end
		task.defer(function()
			pcall(function()
				LocalPlayer.ReplicationFocus = hrp
			end)
			pcall(function()
				LocalPlayer:RequestStreamAroundAsync(hrp.Position, 8)
			end)
		end)
	end

	local function spectateCamera()
		return workspace.CurrentCamera
	end

	local function viewSpectatePlayer(targetPlayer)
		local cam = spectateCamera()
		if not cam then
			return
		end
		if targetPlayer and targetPlayer.Character then
			local hum = targetPlayer.Character:FindFirstChildWhichIsA("Humanoid")
			if hum then
				cam.CameraSubject = hum
				spectateCurrentTarget = targetPlayer
				if targetPlayer ~= LocalPlayer then
					disconnectStreamCharacterFollow()
					streamCharConn = targetPlayer.CharacterAdded:Connect(function(ch)
						task.defer(function()
							tryImproveStreamingAroundCharacter(ch)
						end)
					end)
					tryImproveStreamingAroundCharacter(targetPlayer.Character)
				else
					disconnectStreamCharacterFollow()
					clearStreamingFocus()
				end
				return
			end
		end
		spectateCurrentTarget = nil
		disconnectStreamCharacterFollow()
		clearStreamingFocus()
		local myChar = LocalPlayer.Character
		if myChar then
			local hum = myChar:FindFirstChildWhichIsA("Humanoid")
			if hum then
				cam.CameraSubject = hum
			end
		end
	end

