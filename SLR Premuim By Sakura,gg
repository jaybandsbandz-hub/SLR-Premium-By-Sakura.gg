function EliteLib:CreateToggle(parent, text, callback, flagId, subtitleText)
    local id = flagId or text
    local Toggle = Instance.new("Frame", parent); Toggle.Name = "ItemFrame"; Toggle.Size = subtitleText and UDim2.new(1, 0, 0, 88) or UDim2.new(1, 0, 0, 44); Toggle.BackgroundTransparency = 0.3; Toggle.BackgroundColor3 = Color3.fromRGB(15,15,20); Instance.new("UICorner", Toggle).CornerRadius = UDim.new(0, 10); Toggle.ZIndex = 21
    local l = Instance.new("TextLabel", Toggle); l.Name = "Label"; l.Size = UDim2.new(1, -68, subtitleText and 0 or 1, subtitleText and 25 or 0); l.Position = UDim2.new(0, 16, 0, subtitleText and 5 or 0); l.BackgroundTransparency = 1; l.Text = text; l.TextColor3 = Color3.new(1,1,1); l.TextSize = 14; l.Font = Enum.Font.GothamBold; l.TextXAlignment = Enum.TextXAlignment.Left; l.ZIndex = 22
    
    local subtitle
    if subtitleText then
        subtitle = Instance.new("TextLabel", Toggle); subtitle.Name = "Subtitle"; subtitle.Size = UDim2.new(1, -75, 0, 52); subtitle.Position = UDim2.new(0, 20, 0, 28); subtitle.BackgroundTransparency = 1; subtitle.Text = subtitleText; subtitle.TextColor3 = Themes.Lofi.Accent; subtitle.TextSize = 10; subtitle.Font = Enum.Font.GothamBold; subtitle.TextXAlignment = Enum.TextXAlignment.Left; subtitle.TextYAlignment = Enum.TextYAlignment.Top; subtitle.ZIndex = 22
        subtitle.TextWrapped = true
    end
    
    local box = Instance.new("Frame", Toggle); box.Name = "Box"; box.Size = UDim2.new(0, 40, 0, 22)
    if subtitleText then
        box.AnchorPoint = Vector2.new(1, 0.5)
        box.Position = UDim2.new(1, -15, 0.5, 0)
    else
        box.Position = UDim2.new(1, -54, 0.5, -11)
    end
    box.BackgroundColor3 = Color3.fromRGB(20,20,30); Instance.new("UICorner", box).CornerRadius = UDim.new(1, 0); box.ZIndex = 22
    local stroke = Instance.new("UIStroke", box); stroke.Name = "Outline"; stroke.Thickness = 2; stroke.Color = Color3.fromRGB(240,100,160); stroke.Transparency = 1; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    local ind = Instance.new("Frame", box); ind.Name = "Ind"; ind.Size = UDim2.new(0, 16, 0, 16); ind.Position = UDim2.new(0, 3, 0.5, -8); ind.BackgroundColor3 = Color3.fromRGB(80,80,100); Instance.new("UICorner", ind).CornerRadius = UDim.new(1, 0); ind.ZIndex = 23
    local clk = Instance.new("TextButton", Toggle); clk.Size = UDim2.new(1, 0, 1, 0); clk.BackgroundTransparency = 1; clk.Text = ""; clk.AutoButtonColor = false; clk.ZIndex = 24
    clk.MouseEnter:Connect(function()
        local currentColor = Toggle.BackgroundColor3
        local currentTransparency = Toggle.BackgroundTransparency
        if CurrentTheme == "Sakura" then
            HoverTween(Toggle, {BackgroundColor3 = Color3.fromRGB(230, 230, 240)}):Play()
        else
            HoverTween(Toggle, {BackgroundTransparency = 0.15}):Play()
        end
        Toggle:SetAttribute("HoverOriginalColor", currentColor)
        Toggle:SetAttribute("HoverOriginalTransparency", currentTransparency)
    end)
    clk.MouseLeave:Connect(function()
        local originalColor = Toggle:GetAttribute("HoverOriginalColor")
        local originalTransparency = Toggle:GetAttribute("HoverOriginalTransparency")
        if CurrentTheme == "Sakura" and originalColor then
            HoverTween(Toggle, {BackgroundColor3 = originalColor}):Play()
        elseif originalTransparency then
            HoverTween(Toggle, {BackgroundTransparency = originalTransparency}):Play()
        end
    end)

    local str = false; EliteLib.Flags[id] = str
    local function SetState(val)
        if type(val) == "string" then
            local low = val:lower()
            val = (low == "true" or low == "1" or low == "yes")
        elseif type(val) == "number" then
            val = val ~= 0
        elseif type(val) ~= "boolean" then
            val = false
        end
        str = val
        
        local targetPos = str and UDim2.new(0, 21, 0.5, -8) or UDim2.new(0, 3, 0.5, -8)
        Tween(ind, {Position = targetPos}):Play()
        
        local isSakura = (CurrentTheme == "Sakura")
        
        if str then
            Tween(box, {BackgroundColor3 = Themes[CurrentTheme].Accent}):Play()
            Tween(stroke, {Transparency = 1}):Play()
            Tween(ind, {BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
        else
            if isSakura then
                Tween(box, {BackgroundColor3 = Color3.fromRGB(255,255,255)}):Play()
                Tween(stroke, {Transparency = 0, Color = Themes[CurrentTheme].Accent}):Play()
                Tween(ind, {BackgroundColor3 = Themes[CurrentTheme].Accent}):Play()
            else
                Tween(box, {BackgroundColor3 = Color3.fromRGB(20,20,30)}):Play()
                Tween(stroke, {Transparency = 1}):Play()
                Tween(ind, {BackgroundColor3 = Color3.fromRGB(80,80,100)}):Play()
            end
        end
        EliteLib.Flags[id] = str
        if callback then callback(str) end
        if (getgenv().SakuraNotifySuppress or 0) <= 0 then
            SakuraNotify(text or id, str and "On" or "Off", 3)
        end
    end
    EliteLib.Elements[id] = { Type = "Toggle", Set = SetState, Box = box, Ind = ind, Stroke = stroke, Label = l, Subtitle = subtitle }
    clk.MouseButton1Click:Connect(function()
        if type(getgenv().SakuraAnyHudPanelAnimating) == "function" and getgenv().SakuraAnyHudPanelAnimating() then
            return
        end
        SetState(not str)
    end)
    addContentChaseGlow(Toggle, 1.4, true)
    return Toggle
end

