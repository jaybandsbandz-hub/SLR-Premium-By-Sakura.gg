            end
        else
            if Settings.Movement and Settings.Movement.Jump and hum.JumpPower == Settings.Movement.Jump.Target then
                hum.JumpPower = nativeJP
            end
        end

        if Settings.Movement and Settings.Movement.Fly and Settings.Movement.Fly.Enabled
            and (Settings.Movement.Fly.Target or 0) > 0
            and IsKeyActive(Settings.Movement.Fly.Key) then
            if not flyBV then
                flyStartTime = tick()
                workspace.Gravity = 0
                flyBV = Instance.new("BodyVelocity", hrp)
                flyBV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
                flyBV.Velocity = hrp.AssemblyLinearVelocity
                hum.PlatformStand = true
            end
            
            local cam = workspace.CurrentCamera
            local speed = Settings.Movement.Fly.Target or 50
            local flyVec = Vector3.new()
            
            local camLook = cam.CFrame.LookVector
            local camRight = cam.CFrame.RightVector
            
            if Services.UIS:IsKeyDown(Enum.KeyCode.W) then
                flyVec = flyVec + camLook
            end
            if Services.UIS:IsKeyDown(Enum.KeyCode.S) then
                flyVec = flyVec - camLook
            end
            if Services.UIS:IsKeyDown(Enum.KeyCode.A) then
                flyVec = flyVec - camRight
            end
            if Services.UIS:IsKeyDown(Enum.KeyCode.D) then
                flyVec = flyVec + camRight
            end
            
            if Services.UIS:IsKeyDown(Enum.KeyCode.Space) then
                flyVec = flyVec + Vector3.new(0, 1, 0)
            end
            if Services.UIS:IsKeyDown(Enum.KeyCode.LeftShift) then
                flyVec = flyVec - Vector3.new(0, 1, 0)
            end
            
            if flyVec.Magnitude > 0 then
                flyVec = flyVec.Unit * speed
            end
            
            local newFlyVel = flyBV.Velocity:Lerp(flyVec, 0.3)
            if (newFlyVel - flyBV.Velocity).Magnitude > 0.18 then
                flyBV.Velocity = newFlyVel
            end
            
            if tick() - flyStartTime >= 0.35 then
                flyOrientSkip += 1
                if flyOrientSkip % 2 == 0 then
            hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, math.atan2(-camLook.X, -camLook.Z), 0)
                end
            end
        else
            if flyBV then
                workspace.Gravity = 196.2
                flyBV:Destroy()
                flyBV = nil
                hum.PlatformStand = false
                hrp.Velocity = Vector3.new(0, 0, 0)
            end
        end
        
        local veh = Settings.Vehicle
        if veh and veh.SpeedEnabled and (veh.Speed or 0) > 0 then
            if not (hum.SeatPart and hum.SeatPart.Parent) then
                vehBoostRamp = 0
                vehBoostVehicle = nil
            end
            if hum.SeatPart and hum.SeatPart.Parent then
                local vehicle = hum.SeatPart:FindFirstAncestorOfClass("Model")
                if vehicle then
                    local tickNow = tick()
                    if vehMassCacheModel ~= vehicle or (tickNow - vehMassLastCompute) >= VEH_MASS_CACHE_SEC then
                        local m = 0
                        for _, bp in ipairs(vehicle:GetDescendants()) do
                            if bp:IsA("BasePart") and not bp.Massless then
                                m = m + bp.Mass
                            end
                        end
                        vehMassCacheMass = m
                        vehMassCacheModel = vehicle
                        vehMassLastCompute = tickNow
                    end
                    local heavyFactor = math.clamp((vehMassCacheMass - 320) / 1100, 0, 1)

                    if vehSeatCacheModel ~= vehicle then
                        vehSeatCacheModel = vehicle
                        vehSeatCacheSeat = nil
                        for _, d in ipairs(vehicle:GetDescendants()) do
                            if d:IsA("VehicleSeat") then
                                vehSeatCacheSeat = d
                                break
                            end
                        end
                    end
                    local part = vehSeatCacheSeat
                    if part and not part.Parent then
                        vehSeatCacheSeat = nil
                        vehSeatCacheModel = nil
                        part = nil
                    end
                    if part then
                        local function applyLinV(v)
                            local c = part.AssemblyLinearVelocity
                            if (c - v).Magnitude > 0.28 then
                                part.AssemblyLinearVelocity = v
                            end
                        end
                        local function applyAngV(v)
                            local c = part.AssemblyAngularVelocity
                            if (c - v).Magnitude > 0.14 then
                                part.AssemblyAngularVelocity = v
                            end
                        end

                            local currentVel = part.AssemblyLinearVelocity
                            
                            local isAccelerating = part.ThrottleFloat > 0
                            local isSteering = math.abs(part.SteerFloat) > 0.1
                            local angularVel = part.AssemblyAngularVelocity
                            
                            if vehBoostVehicle ~= vehicle then
                                vehBoostRamp = 0
                                vehBoostVehicle = vehicle
                            end
                            if isAccelerating and part.ThrottleFloat > 0.02 then
                                local rampSec = 2.05 - 0.045 * math.clamp(veh.Speed or 1, 1, 10)
                                vehBoostRamp = math.min(1, vehBoostRamp + dt / rampSec)
                            else
                                vehBoostRamp = math.max(0, vehBoostRamp - dt * 5)
                            end

                            -- Slider S = 1..10: top speed and accel ramp up gently at low S, much more at high S.
                            local S = math.clamp(veh.Speed or 0, 0, 10)
                            local S2 = S * S
                            local maxSpeed = math.min(97 + 7.4 * S + 1.12 * S2, 252)
                            
                            local carFwd = part.CFrame:VectorToWorldSpace(Vector3.new(0, 0, -1))
                            local fwdH = Vector3.new(carFwd.X, 0, carFwd.Z)
                            if fwdH.Magnitude > 1e-3 then
                                fwdH = fwdH.Unit
                                local velH = Vector3.new(currentVel.X, 0, currentVel.Z)
                                local alongF = velH:Dot(fwdH)
                                if isAccelerating and alongF < -0.5 then
                                    local bleed = math.clamp(-alongF * 0.45, 0, 55)
                                    velH = velH + fwdH * bleed
                                    currentVel = Vector3.new(velH.X, currentVel.Y, velH.Z)
                                    applyLinV(currentVel)
                                end
                            end
                            
                            local speed = currentVel.Magnitude
                            local rampT = vehBoostRamp * vehBoostRamp * (3 - 2 * vehBoostRamp)
                            local speedGate = math.clamp(speed / 48, 0, 1)
                            local cheatScale = rampT * (1 - speedGate) + speedGate
                            
                            if isAccelerating and veh.Speed > 0 and speed < maxSpeed then
                                if speed < 40 then
                                    local lowBand = (1 - speed / 40)
                                    local accelGain = S * (0.007 + 0.00135 * S)
                                    local accelBoost = 1 + accelGain * lowBand * cheatScale
                                    local targetVel = currentVel * accelBoost
                                    applyLinV(targetVel)
                                elseif speed > 5 then
                                    local multPerStep = 0.00018 * S + 0.000085 * S2
                                    local multiplier = 1 + multPerStep * cheatScale
                                    local targetVel = currentVel * multiplier
                                    applyLinV(targetVel)
                                end
                            elseif speed > maxSpeed then
                                applyLinV(currentVel.Unit * maxSpeed)
                            elseif not isAccelerating and speed > 1 then
                                applyLinV(currentVel * 0.995)
                            end
                            
                            do
                                local TRAC_DEAD = 0.11
                                local TRAC_ON = 0.13
                                local TRAC_HOLD_SEC = 0.27
                                local TRAC_POST_SEC = 0.2
                                local smTr = math.abs(part.SteerFloat)
                                if vehicle ~= tracVehicle then
                                    tracVehicle = vehicle
                                    tracSteerStart = nil
                                    tracLongHold = false
                                    tracPostUntil = 0
                                end
                                local nowT = tick()
                                if smTr > TRAC_ON then
                                    if not tracSteerStart then
                                        tracSteerStart = nowT
                                    end
                                    if nowT - tracSteerStart >= TRAC_HOLD_SEC then
                                        tracLongHold = true
                                    end
                                else
                                    if tracSteerStart then
                                        local heldT = nowT - tracSteerStart
                                        if heldT < TRAC_HOLD_SEC and heldT > 0.015 and not tracLongHold then
                                            tracPostUntil = nowT + TRAC_POST_SEC
                                        end
                                        tracSteerStart = nil
                                        tracLongHold = false
                                    end
                                end
                                local forwardGas = part.ThrottleFloat > 0
                                local postGrip = nowT < tracPostUntil and smTr < 0.34
                                local wantStraightTraction = forwardGas and not tracLongHold and (smTr <= TRAC_DEAD or postGrip)
                                if wantStraightTraction and fwdH.Magnitude > 1e-3 then
                                    local vel = part.AssemblyLinearVelocity
                                    local vFlat = Vector3.new(vel.X, 0, vel.Z)
                                    local rightH = fwdH:Cross(Vector3.new(0, 1, 0))
                                    if rightH.Magnitude > 1e-3 then
                                        rightH = rightH.Unit
                                        local lateral = vFlat:Dot(rightH)
                                        if math.abs(lateral) > 0.4 then
                                            local grip = 0.13 + 0.09 * math.clamp(speed / 88, 0.45, 1.05)
                                            vFlat = vFlat - rightH * (lateral * grip)
                                            applyLinV(Vector3.new(vFlat.X, vel.Y, vFlat.Z))
                                        end
                                    end
                                end
                            end
                            
                            if speed > 10 and veh.Speed > 0 then
                                local angMag = angularVel.Magnitude
                                if angMag > 0.75 then
                                    local sr = math.clamp(speed / math.max(maxSpeed, 50), 0, 1)
                                    local damp = 0.885 - sr * 0.095
                                    if heavyFactor > 0.12 and isSteering then
                                        damp = math.min(damp + 0.08 + 0.09 * heavyFactor, 0.955)
                                    end
                                    if angMag > 3.8 then
                                        damp = damp * 0.91
                                    end
                                    damp = math.clamp(damp, 0.78, 0.945)
                                    if not (heavyFactor > 0.38 and isSteering and angMag < 4.8) then
                                        applyAngV(angularVel * damp)
                                    end
                                end
                            end

                            if speed > 8 and veh.Speed > 0 and isSteering then
                                local h = heavyFactor
                                local steerAmt = part.SteerFloat

                                if vehTurnInVehicle ~= vehicle then
                                    vehTurnInLastSteer = 0
                                    vehTurnInVehicle = vehicle
                                end
                                local steerMore = math.abs(steerAmt) > math.abs(vehTurnInLastSteer) + 0.18
                                vehTurnInLastSteer = steerAmt

                                local assist05 = 1.05
                                local turnBoost = veh.Speed * (0.38 + 0.72 * h + 0.12 * h * h) * assist05
                                local turnInner = 46 + math.floor(28 * h + 6 * math.clamp(speed / math.max(maxSpeed, 1), 0, 1) + veh.Speed * 0.2 * h)
                                local maxTurn = math.min(107, math.max(1, math.floor(turnInner * assist05)))
                                part.TurnSpeed = math.clamp(part.TurnSpeed + turnBoost, 0, maxTurn)

                                if math.abs(steerAmt) > 0.07 then
                                    local cornerBias = 1.04 + math.clamp((48 - speed) / 120, 0, 0.28)
                                    local spFactor = math.clamp(speed / 88, 0.4, 1.05)
                                    if h > 0.22 then
                                        spFactor = math.max(spFactor, 0.52)
                                    end
                                    local baseKick = 0.14 + 0.95 * h + 0.14 * h * h
                                    local yawKick = -steerAmt * baseKick * spFactor * (0.72 + veh.Speed * 0.032) * cornerBias * assist05
                                    if steerMore then
                                        yawKick = yawKick * 1.04
                                    end
                                    local av = part.AssemblyAngularVelocity
                                    local yNow = av.Y
                                    local assistDir = yawKick > 0 and 1 or -1
                                    local sameAsAssist = (assistDir > 0 and yNow > 0.25) or (assistDir < 0 and yNow < -0.25)
                                    if sameAsAssist and math.abs(yNow) > 1.6 then
                                        local sat = math.clamp(1.25 - math.abs(yNow) / 8, 0.45, 1)
                                        yawKick = yawKick * sat
                                    end
                                    applyAngV(Vector3.new(av.X, av.Y + yawKick, av.Z))
                                end
                        end
                    end
                end
            end
        end
    end
end)

