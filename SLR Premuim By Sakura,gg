            return red
        end
        for _, row in ipairs(scrollFrame:GetChildren()) do
            if row:IsA("Frame") and row.Name:sub(1, 10) == "ServerRow_" then
                local isCur = row:GetAttribute("SBCurrent") == 1
                local isFull = row:GetAttribute("SBFull") == 1
                local fill = row:FindFirstChild("FillBar")
                local bar = row:FindFirstChild("StatusBar")
                local joinBtn = row:FindFirstChild("JoinButton")
                local rowBg = (name == "Sakura" and Color3.fromRGB(250, 248, 252) or contentPanel:Lerp(Color3.new(0, 0, 0), 0.12))
                if isCur then
                    row.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(230, 255, 238) or Color3.fromRGB(20, 45, 30))
                    if fill then fill.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(200, 255, 215) or Color3.fromRGB(25, 60, 35)) end
                    if bar then bar.BackgroundColor3 = green end
                    if joinBtn and joinBtn:IsA("TextButton") then
                        joinBtn.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(180, 255, 200) or Color3.fromRGB(32, 115, 50))
                        joinBtn.TextColor3 = (name == "Sakura" and Color3.fromRGB(20, 90, 40) or Color3.fromRGB(200, 255, 210))
                    end
                elseif isFull then
                    row.BackgroundColor3 = rowBg:Lerp(Color3.new(0, 0, 0), 0.08)
                    if fill then fill.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(255, 230, 230) or Color3.fromRGB(55, 25, 25)) end
                    if bar then bar.BackgroundColor3 = red end
                    if joinBtn and joinBtn:IsA("TextButton") then
                        joinBtn.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(255, 210, 215) or Color3.fromRGB(55, 25, 25))
                        joinBtn.TextColor3 = (name == "Sakura" and Color3.fromRGB(160, 40, 55) or Color3.fromRGB(255, 160, 160))
                    end
                else
                    row.BackgroundColor3 = rowBg
                    if fill then fill.BackgroundColor3 = (name == "Sakura" and Color3.fromRGB(235, 240, 255) or Color3.fromRGB(18, 22, 40)) end
                    if joinBtn and joinBtn:IsA("TextButton") and joinBtn.Active ~= false then
                        joinBtn.BackgroundColor3 = theme.Accent
                        joinBtn.TextColor3 = Color3.new(1, 1, 1)
                    end
                    if bar then
                        local pv = nil
                        for _, ch in ipairs(row:GetChildren()) do
                            if ch:IsA("TextLabel") and ch.Name == "Ping" then
                                pv = tonumber(ch.Text:match("%d+"))
