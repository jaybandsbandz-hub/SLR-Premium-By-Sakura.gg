        return
    end
    -- Spectate layout baseline (from POPOUT_LAYOUT_SNAPSHOT); height still clamps on short viewports.
    local SPEC_LEFT_X = 7
    local SPEC_TOP_OFF = -452
    local SPEC_WIDTH = 268
    local desiredH = 334
    local h = math.max(ScreenGui.AbsoluteSize.Y, 360)
    local specTopPx = h * 0.5 + SPEC_TOP_OFF
    local gapAboveAnchor = 8
    local wmRef = getgenv().SpectateWatermarkRef
