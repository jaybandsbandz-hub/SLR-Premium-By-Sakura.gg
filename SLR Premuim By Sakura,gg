        local accent = th.Accent
        local joinHereBg = (themeName == "Sakura" and Color3.fromRGB(180, 255, 200) or Color3.fromRGB(32, 115, 50))
        local joinHereTx = (themeName == "Sakura" and Color3.fromRGB(20, 90, 40) or Color3.fromRGB(200, 255, 210))
        local joinFullBg = (themeName == "Sakura" and Color3.fromRGB(255, 210, 215) or Color3.fromRGB(55, 25, 25))
        local joinFullTx = (themeName == "Sakura" and Color3.fromRGB(160, 40, 55) or Color3.fromRGB(255, 160, 160))

        local filtered = {}
        for _, s in ipairs(allServers) do
            local playing = s.playing or 0
            local maxP = math.max(s.maxPlayers or 1, 1)
            local filterPing = (s.id == game.JobId) and livePingMs() or apiPingMs(s)
            if activeFilter == "All" then
                table.insert(filtered, s)
            elseif activeFilter == "Small" then
                -- Low population: not mostly full (Desc-only fetch used to hide these from the list).
                local ratio = playing / maxP
                if ratio <= 0.55 or playing <= 12 then
                    table.insert(filtered, s)
                end
            elseif activeFilter == "Good Ping" then
                if filterPing ~= nil and filterPing <= 80 then table.insert(filtered, s) end
            end
        end
        if activeFilter == "Good Ping" then
            table.sort(filtered, function(a, b)
                local pa = (a.id == game.JobId) and livePingMs() or apiPingMs(a)
                local pb = (b.id == game.JobId) and livePingMs() or apiPingMs(b)
                return (pa or 9999) < (pb or 9999)
            end)
        elseif activeFilter == "Small" then
            table.sort(filtered, function(a, b) return (a.playing or 0) < (b.playing or 0) end)
        else
            table.sort(filtered, function(a, b)
                if a.id == game.JobId then return true end
                if b.id == game.JobId then return false end
                return (a.playing or 0) > (b.playing or 0)
            end)
        end
        if #filtered == 0 then
            local msg = Instance.new("TextLabel")
            msg.Name = "EmptyMessage"
            msg.Text = activeFilter == "Good Ping" and "⚡ No API ping ≤80ms" or (activeFilter == "Small" and "🟢 No small servers" or "🌐 No servers")
            msg.Size = UDim2.new(1, 0, 0, 40)
            msg.BackgroundTransparency = 1
            msg.Font = Enum.Font.Gotham
            msg.TextSize = 10
            msg.TextColor3 = textMuted
            msg.ZIndex = 23
            msg.Parent = scrollFrame
        end
        for i, s in ipairs(filtered) do
            buildRow(i, s, rowBg, rowAlt, textMain, textMuted, accent, joinHereBg, joinHereTx, joinFullBg, joinFullTx)
        end
        serverCountLabel.Text = #filtered .. "/" .. #allServers
    end

    local function loadServers()
        loadGeneration += 1
        local gen = loadGeneration

        statusLabel.Text = "⏳ Loading…"
        statusLabel.TextColor3 = yellow
        serverCountLabel.Text = ""
        refreshBtn.Text = "…"
        refreshBtn.Active = false

        local acc = {}
        local seen = {}
        local lastErr = nil

        local function isThrottleMessage(msg)
            if type(msg) ~= "string" then return false end
            local l = string.lower(msg)
            return string.find(l, "too many", 1, true) ~= nil
                or string.find(l, "thrott", 1, true) ~= nil
                or string.find(l, "429", 1, true) ~= nil
                or string.find(l, "frequency", 1, true) ~= nil
        end

        local function fetchPage(sort, maxPg)
            local cursor = ""
            local pages = 0
            repeat
                if gen ~= loadGeneration then return end
                local tail = (cursor ~= "" and ("&cursor=" .. Services.Http:UrlEncode(cursor))) or ""
                local url = "https://games.roblox.com/v1/games/"
                    .. tostring(publicServersPlaceId)
                    .. "/servers/Public?sortOrder="
                    .. sort
                    .. "&limit=100"
                    .. tail

                local ok, result
                for attempt = 1, 4 do
                    if gen ~= loadGeneration then return end
                    ok, result = pcall(function()
                        return Services.Http:JSONDecode(game:HttpGet(url))
                    end)
                    if not ok then
                        local errStr = tostring(result)
                        if attempt < 4 and isThrottleMessage(errStr) then
                            task.wait(3 + attempt * 2)
                        else
                            lastErr = errStr ~= "" and errStr or "HttpGet/JSON failed"
                            break
                        end
                    elseif type(result) ~= "table" then
                        lastErr = "Invalid API response (not JSON object)"
                        ok = false
                        break
                    elseif type(result.errors) == "table" and #result.errors > 0 then
                        local e = result.errors[1]
                        local em = (type(e) == "table" and tostring(e.message or e.userFacingMessage or "")) or ""
                        if attempt < 4 and isThrottleMessage(em) then
                            task.wait(3 + attempt * 2)
                        else
                            lastErr = em ~= "" and em or "API error"
                            ok = false
                            break
                        end
                    else
                        break
                end
            end
            
                if not ok or type(result) ~= "table" then
                    break
                end
                local data = result.data
                if data == nil then
                    data = {}
                elseif type(data) ~= "table" then
                    lastErr = "Invalid API response (data not a list)"
                    break
                end
                for _, s in ipairs(data) do
                    if type(s) == "table" and type(s.id) == "string" and not seen[s.id] then
                        seen[s.id] = true
                        table.insert(acc, s)
                    end
                end
                lastErr = nil
                cursor = type(result.nextPageCursor) == "string" and result.nextPageCursor or ""
                pages += 1
                if cursor ~= "" and pages < maxPg then
                    task.wait(2.0 + math.random() * 0.5)
                end
            until cursor == "" or pages >= maxPg
        end

        -- Desc = busiest (typical browse); Asc = emptier servers for SM / tail of list. Spaced to limit throttling.
        task.wait(1.0 + math.random() * 0.6)
        fetchPage("Desc", 1)
        if gen ~= loadGeneration then return end
        task.wait(1.35 + math.random() * 0.55)
        fetchPage("Asc", 1)
        if gen ~= loadGeneration then return end
        -- If we got any public rows, do not surface a hard error from the optional second page alone.
        local publicRows = 0
        for _, s in ipairs(acc) do
            if type(s) == "table" and s.id ~= game.JobId then
                publicRows += 1
            end
        end
        if publicRows > 0 then
            lastErr = nil
        end

        if not seen[game.JobId] then
            table.insert(acc, 1, {
                id = game.JobId,
                playing = #Services.Players:GetPlayers(),
                maxPlayers = Services.Players.MaxPlayers,
                ping = livePingMs(),
            })
            seen[game.JobId] = true
        end
        allServers = acc

        local th = Themes[CurrentTheme]
        if lastErr then
            statusLabel.Text = "⚠️ " .. string.sub(lastErr, 1, 100)
            statusLabel.TextColor3 = red
        else
            statusLabel.Text = "✅ Loaded"
            statusLabel.TextColor3 = th.Accent
        end
        refreshBtn.Text = "🔄 Refresh"
        refreshBtn.Active = true
        renderServers()
    end

