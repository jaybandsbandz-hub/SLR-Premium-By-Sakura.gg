    list.ZIndex = 100
    list.ScrollBarThickness = 4
    list.AutomaticCanvasSize = Enum.AutomaticSize.None
    list.CanvasSize = UDim2.new(0, 0, 0, 0)
    list.BorderSizePixel = 0
    list.ScrollingEnabled = false
    list.ElasticBehavior = Enum.ElasticBehavior.Never
    list.ScrollingDirection = Enum.ScrollingDirection.Y

    applySakuraScrollFrameFeel(list, { direction = Enum.ScrollingDirection.Y, elastic = Enum.ElasticBehavior.Never })

    local topSpacer = Instance.new("Frame", list)
    topSpacer.Name = "TopSpacer"
    topSpacer.Size = UDim2.new(1, 0, 0, 4)
