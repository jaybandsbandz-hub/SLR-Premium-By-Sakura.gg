local function GetNearestLocation(pos)
    local closest, dist = "Unknown", math.huge
    for _, loc in pairs(NamedLocations) do
        local d = (loc.Pos - pos).Magnitude
        if d < dist then dist = d; closest = loc.Name end
    end
    return closest
end

