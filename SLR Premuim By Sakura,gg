ConnectCore("PlayerStepped", Services.RunService.Stepped, function(_, step)
    local dt = (type(step) == "number" and step > 0 and step < 0.2) and step or (1 / 60)
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
