local SakuraMenuShell = (function()
    local SakuraMenuChipRelocated = false
    local menuShellSizeTween = nil
    local menuShellFadeTween = nil
    local menuAnimGeneration = 0

    local function menuBackdropFadeTarget()
        if CurrentTheme == "Lofi" and LofiBG then
            return LofiBG, "ImageTransparency"
        end
        return BaseBG, "BackgroundTransparency"
    end

    local function menuOpenChipShouldShow()
        return EliteLib.Flags["MenuOpenChip_Toggle"] ~= false
    end

    local function cancelMenuShellTweens()
        if menuShellSizeTween then
            pcall(function()
                menuShellSizeTween:Cancel()
            end)
            menuShellSizeTween = nil
        end
        if menuShellFadeTween then
            pcall(function()
                menuShellFadeTween:Cancel()
            end)
            menuShellFadeTween = nil
        end
    end

    local function hideMainMenuAnimated(onDone)
        if isAnimating then return end
        
        if not MainFrame.Visible then
            if onDone then
                task.defer(onDone)
            end
            return
        end
        cancelMenuShellTweens()
