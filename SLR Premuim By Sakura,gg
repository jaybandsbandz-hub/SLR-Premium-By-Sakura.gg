-- Single Heartbeat driver replaces multiple task.wait spin loops (was ~150+ wakes/sec combined).
do
    local chaseSpinAccum = 0
    local CHASE_SPIN_PERIOD = 1 / 28
    local rotation = 0
    local accentRotation = 0
    ConnectCore("EliteMenuChase", Services.RunService.Heartbeat, function(dt)
        if getgenv().EliteHubV2_Shutdown then
            return
        end
        chaseSpinAccum += dt
        if chaseSpinAccum < CHASE_SPIN_PERIOD then
            return
        end
        chaseSpinAccum -= CHASE_SPIN_PERIOD

        local wm = getgenv().SpectateWatermarkRef
        local wmVis = wm and wm.Visible
        local mainVis = MainFrame and MainFrame.Visible
        local statsVis = StatsBarHUD and StatsBarHUD.Visible
        local scanVis = ScanMenuChrome and ScanMenuChrome.Visible
        local wlVis = WhitelistPanel and WhitelistPanel.Visible
        local chipVis = MenuOpenChip and MenuOpenChip.Visible
        local popVis = (ScannerHUD and ScannerHUD.Visible)
            or (RemoteHUD and RemoteHUD.Visible)
            or (SpectateHUD and SpectateHUD.Visible)
        if not (mainVis or statsVis or scanVis or wlVis or popVis or wmVis or chipVis) then
            return
        end

        rotation = (rotation + 37.5 * CHASE_SPIN_PERIOD) % 360
        accentRotation = (accentRotation + 15 * CHASE_SPIN_PERIOD) % 360

        if mainVis then
            if StrokeGradient then
                StrokeGradient.Rotation = rotation
            end
            if getgenv().MainGlowStrokes then
                for _, stroke in ipairs(getgenv().MainGlowStrokes) do
                    local kg = stroke:FindFirstChild("KeyGlowGrad")
                    if kg and kg:IsA("UIGradient") then
                        kg.Rotation = rotation
                    end
                end
            end
            if StatsBarStrokeGradient then
                StatsBarStrokeGradient.Rotation = rotation * 0.38
            end
            if getgenv().TopBarChaseGradients then
                for _, grad in ipairs(getgenv().TopBarChaseGradients) do
                    if grad and grad.Parent then
                        grad.Rotation = rotation
                    end
                end
            end
            if getgenv().TabIconChaseGradients then
                for _, grad in ipairs(getgenv().TabIconChaseGradients) do
                    if grad and grad.Parent then
                        grad.Rotation = rotation
                    end
                end
            end
            if getgenv().ContentChaseGradients then
                for _, grad in ipairs(getgenv().ContentChaseGradients) do
                    if grad and grad.Parent then
                        grad.Rotation = rotation
                    end
                end
            end
            if LogoStrokeGradient then
                LogoStrokeGradient.Rotation = rotation
            end
            if AccentStrokeGradient then
                AccentStrokeGradient.Rotation = accentRotation
                if getgenv().AccentGlowStrokes then
                    for _, glowData in ipairs(getgenv().AccentGlowStrokes) do
                        if glowData.gradient then
                            glowData.gradient.Rotation = accentRotation
                        end
                    end
                end
            end
        end

        if (popVis or chipVis) and getgenv().HUDPopoutChaseGradients then
            for _, grad in ipairs(getgenv().HUDPopoutChaseGradients) do
                if grad and grad.Parent then
                    grad.Rotation = rotation
                end
            end
        end

        if statsVis then
            local led = HUDLEDData and HUDLEDData["StatsBar"]
            local sg = led and led.Gradient
            if sg and sg.Parent then
                sg.Rotation = rotation
            end
        end

        if scanVis then
            local led = HUDLEDData and HUDLEDData["ScanMenu"]
            local sg = led and led.Gradient
            if sg and sg.Parent then
                sg.Rotation = rotation
            end
        end

        if wlVis and getgenv().WLChaseGradient and getgenv().WLChaseGradient.Parent then
            getgenv().WLChaseGradient.Rotation = rotation
        end

        if wmVis and getgenv().WatermarkChaseGradients then
            for _, grad in ipairs(getgenv().WatermarkChaseGradients) do
                if grad and grad.Parent then
                    grad.Rotation = rotation
                end
            end
        end

        if StatsLogoStrokeGradient and StatsLogoStrokeGradient.Parent and (mainVis or statsVis) then
            StatsLogoStrokeGradient.Rotation = rotation
        end
    end)
end

