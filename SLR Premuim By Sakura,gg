    if wmRef and not wmRef.Visible then
        bottomLimit = h - gapAboveAnchor
    else
        bottomLimit = h + (-42) - gapAboveAnchor
    end
    local maxH = math.floor(bottomLimit - specTopPx)
    maxH = math.max(120, maxH)
    local finalH = math.max(120, math.min(desiredH, maxH))
    SpectateHUD.Position = UDim2.new(0, SPEC_LEFT_X, 0.5, SPEC_TOP_OFF)
    SpectateHUD.Size = UDim2.new(0, SPEC_WIDTH, 0, finalH)
end
