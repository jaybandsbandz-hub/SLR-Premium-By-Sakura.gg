do
    local lagActive = false
    local origShadow = nil
    local origTech = nil
    local disabled = {}
    local origQualityLevel = nil
    local origSavedQualityLevel = nil

    local function saveAndSet(obj, prop, val)
        local ok, orig = pcall(function()
            return obj[prop]
        end)
        if ok then
            table.insert(disabled, { obj = obj, prop = prop, orig = orig })
            pcall(function()
                obj[prop] = val
            end)
        end
    end

    local function restoreAll()
        for _, d in ipairs(disabled) do
            pcall(function()
                if d.obj and (d.obj.Parent ~= nil or d.prop == "Parent") then
                    d.obj[d.prop] = d.orig
                end
            end)
        end
