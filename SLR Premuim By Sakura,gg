        end)
        if mb4Pressed then return true end
        return Services.UIS:IsKeyDown(Enum.KeyCode.F12)
    elseif keyEnum == Enum.KeyCode.F11 then
        local mb5Pressed = false
        pcall(function()
            mb5Pressed = Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton5)
        end)
        if mb5Pressed then return true end
        return Services.UIS:IsKeyDown(Enum.KeyCode.F11)
    end
    
    if keyEnum.EnumType == Enum.KeyCode then return Services.UIS:IsKeyDown(keyEnum) end
    if keyEnum.EnumType == Enum.UserInputType then
        if keyEnum == Enum.UserInputType.MouseButton1 then return Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) end
        if keyEnum == Enum.UserInputType.MouseButton2 then return Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) end
        if keyEnum == Enum.UserInputType.MouseButton3 then return Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton3) end
        if keyEnum == Enum.UserInputType.MouseButton4 then
            local ok, d = pcall(function()
