local ActiveConnections = {}

local function TrackConnection(name, connection)
    if ActiveConnections[name] then
        pcall(function()
            ActiveConnections[name]:Disconnect()
        end)
    end
    ActiveConnections[name] = connection
end

local function DisconnectConnection(name)
    local conn = ActiveConnections[name]
    if conn then
        pcall(function()
            conn:Disconnect()
        end)
        ActiveConnections[name] = nil
    end
end

local function DisconnectAll()
    for name, conn in pairs(ActiveConnections) do
        pcall(function()
            conn:Disconnect()
        end)
        ActiveConnections[name] = nil
    end
end

local CoreConnections = {}

local function ConnectCore(name, signal, handler)
    if CoreConnections[name] then
        pcall(function()
            CoreConnections[name]:Disconnect()
        end)
    end
    local conn = signal:Connect(handler)
    CoreConnections[name] = conn
    return conn
end

local function DisconnectCoreAll()
    for name, conn in pairs(CoreConnections) do
        pcall(function()
            conn:Disconnect()
        end)
        CoreConnections[name] = nil
    end
end

