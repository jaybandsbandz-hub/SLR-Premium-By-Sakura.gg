local function SakuraNotify(titleText, msg, timeShow)
	timeShow = timeShow or 4
	if not notifyHolder or not notifyHolder.Parent then
		return
	end
	notifyDismissGen += 1
	local gen = notifyDismissGen

	local size = Services.TextService:GetTextSize(
		tostring(msg or ""),
		12,
		Enum.Font.GothamMedium,
		Vector2.new(270, 9999)
	)
	local height = math.max(58, size.Y + 34)

	notifyTitle.Text = tostring(titleText or "Sakura")
	notifyBody.Text = tostring(msg or "")
	notifyBody.Size = UDim2.new(1, -14, 0, math.max(26, size.Y))
	notifyToast.Size = UDim2.new(1, 0, 0, height)
	notifyToast.Visible = true

	task.delay(timeShow, function()
		if gen ~= notifyDismissGen then
			return
		end
		notifyToast.Visible = false
	end)
end
