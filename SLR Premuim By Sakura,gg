	local function SakuraAnimateWatermarkOpen()
		if not watermark then
			return
		end
		cancelHudPanelTween(watermark)
		HUDAnimating[watermark] = false
		if not (EliteLib.Flags and EliteLib.Flags["SpectateWatermark_Toggle"]) then
			return
		end
		HUDAnimating[watermark] = true
		watermark.ClipsDescendants = true
		watermark.AnchorPoint = WM_CENTER_AP
		watermark.Position = WM_CENTER_POS
		watermark.Size = UDim2.fromOffset(0, 0)
		watermark.Visible = true
		local tw = Services.Tween:Create(watermark, TweenInfo.new(PANEL_ANIM_DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), { Size = WM_REST_SIZE })
		HudPanelTween[watermark] = tw
		tw:Play()
		local openDone
		openDone = tw.Completed:Connect(function(state)
			if state ~= nil and state ~= Enum.PlaybackState.Completed then
				if HudPanelTween[watermark] == tw then
					HudPanelTween[watermark] = nil
				end
				openDone:Disconnect()
				return
			end
			if HudPanelTween[watermark] == tw then
				HudPanelTween[watermark] = nil
			end
			watermark.ClipsDescendants = false
			watermark.AnchorPoint = WM_REST_AP
			watermark.Position = WM_REST_POS
			watermark.Size = WM_REST_SIZE
			HUDAnimating[watermark] = false
			openDone:Disconnect()
		end)
	end

	local function SakuraAnimateWatermarkClose(closeTweenInfo)
		if not watermark then
			return
		end
		cancelHudPanelTween(watermark)
		if not watermark.Visible then
			HUDAnimating[watermark] = false
			return
		end
		HUDAnimating[watermark] = true
		local originalSize = watermark.Size
		local originalPos = watermark.Position
		watermark.ClipsDescendants = true
		if not hudSnapPivotToVisualCenter(watermark) then
			watermark.AnchorPoint = WM_CENTER_AP
			watermark.Position = UDim2.new(
				originalPos.X.Scale,
				originalPos.X.Offset + originalSize.X.Offset / 2,
				originalPos.Y.Scale,
				originalPos.Y.Offset + originalSize.Y.Offset / 2
			)
		end
		local tw = Services.Tween:Create(
			watermark,
			closeTweenInfo or TweenInfo.new(PANEL_ANIM_DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
			{ Size = UDim2.new(0, 0, 0, 0) }
		)
		HudPanelTween[watermark] = tw
		tw:Play()
		local closeDone
		closeDone = tw.Completed:Connect(function(state)
			if state ~= nil and state ~= Enum.PlaybackState.Completed then
				if HudPanelTween[watermark] == tw then
					HudPanelTween[watermark] = nil
				end
				closeDone:Disconnect()
				return
			end
			if HudPanelTween[watermark] == tw then
				HudPanelTween[watermark] = nil
			end
			watermark.Visible = false
			watermark.Size = WM_REST_SIZE
			watermark.ClipsDescendants = false
			watermark.AnchorPoint = WM_REST_AP
			watermark.Position = WM_REST_POS
			HUDAnimating[watermark] = false
			closeDone:Disconnect()
		end)
	end

