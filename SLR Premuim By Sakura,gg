local function ResolvePromptPart(prompt)
    if prompt.Parent and prompt.Parent:IsA("BasePart") then
        return prompt.Parent
    end
    local a = prompt.Parent
    while a do
        if a:IsA("BasePart") then
            return a
        end
        a = a.Parent
    end
    return nil
end

local function FindPromptIn(container, keywords)
    if not container then return nil end
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            local n = d.Name:lower()
            local p = d.Parent and d.Parent.Name:lower() or ""
            local ok = false
            for _, kw in ipairs(keywords) do
                if n:find(kw) or p:find(kw) then
                    ok = true
                    break
                end
            end
            if ok then return d end
        end
    end
    return nil
end

local function CollectPrompts(container)
    local prompts = {}
    if not container then return prompts end
    for _, d in ipairs(container:GetDescendants()) do
        if d:IsA("ProximityPrompt") then
            table.insert(prompts, d)
        end
    end
    return prompts
end

local function ScorePrompt(prompt, keywords, anchorPos)
    if not prompt or not prompt:IsA("ProximityPrompt") then
        return 0
    end
    local n = string.lower(prompt.Name or "")
    local p = string.lower(prompt.Parent and prompt.Parent.Name or "")
    -- ObjectText/ActionText + short ancestor chain (two "Dealer" prompts often differ here only)
    local blob = string.lower(
        (prompt.ObjectText or "")
            .. " "
            .. (prompt.ActionText or "")
            .. " "
            .. n
            .. " "
            .. p
    )
    local a = prompt.Parent
    for _ = 1, 4 do
        if a and a.Name then
            blob = blob .. " " .. string.lower(a.Name)
            a = a.Parent
        else
            break
        end
    end
    local score = 0
    for _, kw in ipairs(keywords) do
        if n:find(kw) then score = score + 8 end
        if p:find(kw) then score = score + 5 end
        if blob:find(kw) then score = score + 10 end
    end
    if anchorPos then
        local part = ResolvePromptPart(prompt)
        if part then
            local dist = (part.Position - anchorPos).Magnitude
            score = score + math.max(0, 50 - dist)
        end
    end
    return score
end

local function FindBestPrompt(container, keywords, anchorPos)
    local best, bestScore = nil, -math.huge
    for _, p in ipairs(CollectPrompts(container)) do
        local s = ScorePrompt(p, keywords, anchorPos)
        if s > bestScore then
            bestScore = s
            best = p
        end
    end
    return best
end

-- Two "Gun Dealer" prompts: full path + UI text, then pick by index after X/Z sort.
-- Default for AMMO skips the first counter (index 1 is usually the gun line). Override:
--   getgenv().SakuraAmmoDealerIndex = 1   -- use first in sort order (only if your ammo is that one)
--   getgenv().SakuraAmmoDealerIndex = 2   -- use second (default: ignore first = ammo on the other side)
local function GetProximityWorldContextBlob(pr)
    if not pr or not pr:IsA("ProximityPrompt") then
        return ""
    end
    local out = string.lower(
        (pr.ObjectText or "")
            .. " "
            .. (pr.ActionText or "")
            .. " "
            .. (pr.Name or "")
            .. " "
            .. pr:GetFullName()
    )
    -- Signs / labels on the counter (common when ObjectText is identical)
    local root = ResolvePromptPart(pr) or pr.Parent
    if root and root:IsA("Instance") then
        local n = 0
        for _, sub in root:GetDescendants() do
            n = n + 1
            if n > 80 then
                break
            end
            if sub:IsA("TextLabel") or sub:IsA("TextButton") or sub:IsA("TextBox") then
                local t = sub.Text
                if type(t) == "string" and t ~= "" then
                    out = out .. " " .. string.lower(t:sub(1, 200))
                end
            end
        end
    end
    return out
end

local function FindDealerByIntent(gunStore, wantAmmo)
    local list = CollectPrompts(gunStore)
    if #list == 0 then
        return nil
    end
    if #list == 1 then
        return list[1]
    end
    local function pathAmmoScore(blob)
        local s = 0
        for _, w in ipairs({
            "ammunition",
            "ammunation",
            "ammostore",
            "ammoshop",
            "ammo",
            "muni",
            "munition",
            "reup",
            "rounds",
            "round",
            "shell",
            "shells",
            "clip",
            "mags",
            "mag",
            "nato",
            "9mm",
        }) do
            if blob:find(w) then
                s = s + 120
            end
        end
        for _, w in ipairs({
            "weapons",
            "weaponry",
            "pistol",
            "rifle",
            "ar",
            "ar15",
            "glock",
        }) do
            if blob:find(w) and not blob:find("ammo", 1, true) and not blob:find("muni", 1, true) and not blob:find("round", 1, true) then
                s = s - 70
            end
        end
        return s
    end
    local function pathGunScore(blob)
        local s = 0
        for _, w in ipairs({ "wep", "weapons", "guns", "gunrack", "racks", "pistol", "rifle", "glock", "armory" }) do
            if blob:find(w) and not blob:find("ammo", 1, true) and not blob:find("muni", 1, true) then
                s = s + 100
            end
        end
        return s
    end
    local scored = {}
    for _, pr in ipairs(list) do
        local full = GetProximityWorldContextBlob(pr)
        local s
        if wantAmmo then
            s = pathAmmoScore(full) - pathGunScore(full) * 0.4
        else
            s = pathGunScore(full) - pathAmmoScore(full) * 0.4
        end
        table.insert(scored, { pr = pr, s = s, full = full })
    end
    table.sort(scored, function(a, b)
        return a.s > b.s
    end)
    local bestS = scored[1].s
    local top = {}
    for _, e in ipairs(scored) do
        if e.s < bestS - 0.001 then
            break
        end
        table.insert(top, e)
    end
    if #top == 1 then
        return top[1].pr
    end
    if #top == 2 and wantAmmo then
        local t0, t1 = top[1], top[2]
        local a0, a1 = pathAmmoScore(t0.full), pathAmmoScore(t1.full)
        if math.abs(a0 - a1) > 0.5 then
            return (a0 > a1) and t0.pr or t1.pr
        end
        local g0, g1 = pathGunScore(t0.full), pathGunScore(t1.full)
        if math.abs(g0 - g1) > 0.5 then
            return (g0 < g1) and t0.pr or t1.pr
        end
    end
    -- Tied: prefer earlier match for "ammo" in full name (path often has Ammo/ vs Guns/)
    if wantAmmo then
        table.sort(top, function(a, b)
            local fa, fb = a.full, b.full
            local ia, ib = fa:find("ammo", 1, true) or 1e6, fb:find("ammo", 1, true) or 1e6
            if ia ~= ib then
                return ia < ib
            end
            return fa < fb
        end)
        for _, e in ipairs(top) do
            if e.full:find("ammo", 1, true) or e.full:find("muni", 1, true) or e.full:find("round", 1, true) then
                return e.pr
            end
        end
    else
        table.sort(top, function(a, b)
            return a.full < b.full
        end)
    end
    -- World-X order (stable): pick index when game gives identical text everywhere
    table.sort(top, function(a, b)
        local pa, pb = ResolvePromptPart(a.pr), ResolvePromptPart(b.pr)
        if not pa or not pb then
            return a.full < b.full
        end
        if math.abs(pa.Position.X - pb.Position.X) > 0.1 then
            return pa.Position.X < pb.Position.X
        end
        return pa.Position.Z < pb.Position.Z
    end)
    local n = #top
    if n == 0 then
        return list[1]
    end
    local g = getgenv and getgenv() or _G
    local idx
    if wantAmmo then
        idx = g and g.SakuraAmmoDealerIndex
        if type(idx) ~= "number" then
            -- Most maps: 1st prompt = guns, 2nd = ammo. Default 2 = "ignore the first" / skip gun menu.
            idx = 2
        end
    else
        idx = (g and g.SakuraGunDealerIndex)
        if type(idx) ~= "number" then
            idx = 1
        end
    end
    if type(idx) ~= "number" or idx < 1 or idx > n then
        idx = wantAmmo and math.min(2, n) or 1
    end
    return top[math.floor(idx + 0.5)].pr
end

local function FirePromptWithRange(prompt)
    if not prompt then return false end
    local hrp = GetHRP()
    local part = ResolvePromptPart(prompt)
    local originalCF = hrp and hrp.CFrame
    if hrp and part then
        hrp.CFrame = part.CFrame + Vector3.new(0, 0, 3)
        hrp.Velocity = Vector3.new()
        task.wait(0.08)
    end
    pcall(function()
        fireproximityprompt(prompt)
    end)
    if hrp and originalCF then
        task.wait(0.08)
        hrp.CFrame = originalCF
        hrp.Velocity = Vector3.new()
    end
    return true
end

local function FirePromptLocalOnly(prompt)
    if not prompt then return false end
    pcall(function()
        fireproximityprompt(prompt)
    end)
    return true
end

local function tweenHrpCFrame(hrp, targetCF, duration)
    if not hrp or not targetCF then return end
    local tw = Services.Tween:Create(hrp, TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = targetCF })
    tw:Play()
    tw.Completed:Wait()
end

local function RemoteExecute(target)
    local promptParent = nil
    local directPrompt = nil

    if target == "Computer" then
        local buyDoor, computerPos = FindApartmentData()
        if not buyDoor or not computerPos then
            return
        end

        directPrompt = FindPromptIn(computerPos, {"computer", "pc", "use", "interact"})
        if not directPrompt then
            directPrompt = FindPromptIn(buyDoor, {"computer", "pc", "use", "interact"})
        end
        if not directPrompt then
            directPrompt = FindBestPrompt(buyDoor, {"computer", "pc", "terminal", "use", "interact"}, computerPos.Position)
        end
        if not directPrompt then
            return
        end
        
        local promptPart = ResolvePromptPart(directPrompt)
        if promptPart then
            local hrp = GetHRP()
            if hrp then
                local originalCF = hrp.CFrame
                local atPrompt = promptPart.CFrame * CFrame.new(0, 0, 3)
                tweenHrpCFrame(hrp, atPrompt, 0.18)
                hrp.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.06)
                FirePromptLocalOnly(directPrompt)
                task.wait(0.06)
                tweenHrpCFrame(hrp, originalCF, 0.2)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        else
            FirePromptLocalOnly(directPrompt)
        end
        return
    elseif target == "Illegal Merchant" then
        promptParent = workspace.Map:FindFirstChild("FlipsyPrompts") and workspace.Map.FlipsyPrompts:FindFirstChild("Merchant")
        if promptParent then promptParent = promptParent:FindFirstChild("UpperTorso") end
    elseif target == "Black Market" then
        local fp = workspace.Map and workspace.Map:FindFirstChild("FlipsyPrompts")
        if fp then
            promptParent = fp:FindFirstChild("BlackMarket")
                or fp:FindFirstChild("Black_Market")
                or fp:FindFirstChild("BlackMarketNPC")
                or fp:FindFirstChild("BMDealer")
                or fp:FindFirstChild("IllegalMarket")
            if promptParent then
                promptParent = promptParent:FindFirstChild("UpperTorso", true) or promptParent
            end
        end
    elseif target == "Mask" then

        local flipsyPrompts = workspace.Map:FindFirstChild("FlipsyPrompts")
        if flipsyPrompts then
            promptParent = flipsyPrompts:FindFirstChild("MaskShop") 
                or flipsyPrompts:FindFirstChild("Mask")
                or flipsyPrompts:FindFirstChild("MaskStore")
                or flipsyPrompts:FindFirstChild("MaskVendor")
            if promptParent then promptParent = promptParent:FindFirstChild("UpperTorso") end
        end
    elseif target == "ATM" then
        local map = workspace:FindFirstChild("Map")
        local atms = (map and map:FindFirstChild("ATMs")) or workspace:FindFirstChild("ATMs")
        if atms then
            local hrp = GetHRP()
            local anchor = hrp and hrp.Position or nil
            local p = FindBestPrompt(
                atms,
                { "atm", "withdraw", "deposit", "bank", "cash", "machine", "balance", "enter", "use" },
                anchor
            )
            if not p then
                local one = atms:FindFirstChild("ATM", true) or atms:FindFirstChild("Atm", true)
                if one then
                    p = FindBestPrompt(one, { "atm", "withdraw", "deposit", "bank" }, anchor)
                end
            end
            if not p then
                local allc = CollectPrompts(atms)
                if #allc == 1 then
                    p = allc[1]
                end
            end
            if p and p:IsA("ProximityPrompt") then
                FirePromptLocalOnly(p)
            end
        end
        return
    elseif target == "Ammo Dealer" then
        local fp = workspace.Map and workspace.Map:FindFirstChild("FlipsyPrompts")
        if not fp then
            return
        end
        -- GunStore almost always has TWO prompts (gun + ammo). Never use "first ProximityPrompt in
        -- GetDescendants" here — that was opening the gun menu. Handle GunStore only via FindDealerByIntent.
        local gunStore = fp:FindFirstChild("GunStore")
        if gunStore then
            local pPick = FindDealerByIntent(gunStore, true)
            if pPick then
                FirePromptLocalOnly(pPick)
            end
            return
        end
        local function modelUpper(name)
            local m = fp:FindFirstChild(name)
            if not m then
                return nil
            end
            return m:FindFirstChild("UpperTorso", true) or m
        end
        local cont = nil
        for _, n in ipairs({ "AmmoDealer", "AmmoShop", "AmmoStore", "Ammunition" }) do
            cont = modelUpper(n)
            if cont then
                break
            end
        end
        if not cont then
            for _, d in ipairs(fp:GetChildren()) do
                local lname = d.Name:lower()
                if (lname:find("ammo") or lname:find("muni") or lname:find("round") or lname:find("bullet")) and not lname:find("gun") then
                    cont = d:FindFirstChild("UpperTorso", true) or d
                    break
                end
            end
        end
        if cont then
            local plist = CollectPrompts(cont)
            if #plist == 0 then
                return
            end
            if #plist == 1 then
                FirePromptLocalOnly(plist[1])
                return
            end
            local pPick2 = FindDealerByIntent(cont, true)
            if pPick2 then
                FirePromptLocalOnly(pPick2)
            end
            return
        end
        local pFallback = FindBestPrompt(fp, { "ammo", "muni", "round", "shell", "bullet" }, GetHRP() and GetHRP().Position)
        if pFallback then
            FirePromptLocalOnly(pFallback)
        end
        return
    elseif target == "Apartment Safe" then
        local buyDoor, computerPos = FindApartmentData()
        if buyDoor then
            directPrompt = FindPromptIn(buyDoor, {"safe", "vault", "stash"})
            if not directPrompt then
                directPrompt = FindBestPrompt(
                    buyDoor,
                    {"safe", "vault", "storage", "stash", "locker", "open", "interact"},
                    computerPos and computerPos.Position or nil
                )
            end
        end
        if not directPrompt then
            return
        end
        
        local promptPart = ResolvePromptPart(directPrompt)
        if promptPart then
            local hrp = GetHRP()
            if hrp then
                local originalCF = hrp.CFrame
                local atPrompt = promptPart.CFrame * CFrame.new(0, 0, 3)
                tweenHrpCFrame(hrp, atPrompt, 0.18)
                hrp.AssemblyLinearVelocity = Vector3.zero
                task.wait(0.06)
                FirePromptLocalOnly(directPrompt)
                task.wait(0.06)
                tweenHrpCFrame(hrp, originalCF, 0.2)
                hrp.AssemblyLinearVelocity = Vector3.zero
            end
        else
            FirePromptLocalOnly(directPrompt)
        end
        return
    end

    if promptParent then
        for _, child in ipairs(promptParent:GetDescendants()) do
            if child:IsA("ProximityPrompt") then
                FirePromptLocalOnly(child)
                break
            end
        end
    end
end


