    task.defer(function()
        local LocalizationService = game:GetService("LocalizationService")
        local Http = game:GetService("HttpService")

        local countryOk, countryCode = pcall(function()
            return LocalizationService:GetCountryRegionForPlayerAsync(LocalPlayer)
        end)
        if not countryOk or type(countryCode) ~= "string" or countryCode == "" then
            countryCode = "?"
        end

        local function httpGetBody(url)
            local ok, out = pcall(function()
                if type(Http.RequestAsync) == "function" then
                    local resp = Http:RequestAsync({
                        Url = url,
                        Method = "GET",
                    })
                    if resp and resp.Success and type(resp.Body) == "string" and resp.Body ~= "" then
                        return resp.Body
                    end
                end
                return Http:GetAsync(url, true)
            end)
            if ok and type(out) == "string" and out ~= "" then
                return out
            end
            local g = getgenv and getgenv() or nil
            local reqFn = (g and type(g.http_request) == "function" and g.http_request)
                or (g and type(g.request) == "function" and g.request)
            local globalHttp = rawget(_G, "http_request")
            if type(globalHttp) == "function" then
                reqFn = globalHttp
            end
            if reqFn then
                local ok2, res = pcall(function()
                    return reqFn({ Url = url, Method = "GET" })
                end)
                if ok2 and type(res) == "table" then
                    local body = res.Body or res.body
                    local code = res.StatusCode or res.statusCode
                    if type(body) == "string" and body ~= "" and (code == nil or code == 200) then
                        return body
                    end
                end
            end
            return nil
        end

        local function parseUsStateFromJson(data)
            if type(data) ~= "table" then
                return nil
            end
            if data.status == "fail" then
                return nil
            end
            if type(data.regionName) == "string" and data.regionName ~= "" and data.countryCode == "US" then
                return data.regionName
            end
            if data.success == true and type(data.region) == "string" and data.region ~= "" then
                return data.region
            end
            if (data.country_code == "US" or data.countryCode == "US") and type(data.region) == "string" and data.region ~= "" then
                return data.region
            end
            if data.country == "US" and type(data.region) == "string" and data.region ~= "" then
                return data.region
            end
            return nil
        end

        local usState = nil
        if countryCode == "US" then
            local geoUrls = {
                "https://ipwho.is/json",
                "https://ipapi.co/json/",
                "https://get.geojs.io/v1/ip/geo.json",
                "http://ip-api.com/json/?fields=status,message,regionName,region,countryCode",
            }
            for _, geoUrl in ipairs(geoUrls) do
                local body = httpGetBody(geoUrl)
                if body then
                    local decOk, data = pcall(function()
                        return Http:JSONDecode(body)
                    end)
                    if decOk then
                        usState = parseUsStateFromJson(data)
                        if usState then
                            break
                        end
                    end
                end
            end
        end

        if countryCode == "US" and usState then
            regionLine.Text = usState .. ", US"
        elseif countryCode == "US" then
            regionLine.Text = "US"
        else
