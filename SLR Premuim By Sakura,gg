        if type(sec) ~= "number" or sec ~= sec then return nil end
        return math.floor(sec * 1000 + 0.5)
    end

    local function apiPingMs(server)
        local p = server and server.ping
        if type(p) ~= "number" or p ~= p or p < 0 or p > 1e4 then return nil end
        return math.floor(p + 0.5)
    end

    local function rowPingMs(server, isCurrent)
        if isCurrent then return livePingMs() end
        return apiPingMs(server)
    end

    local function pingColor(p)
        if p == nil then return Color3.fromRGB(140, 145, 160) end
        if p <= 80 then return green elseif p <= 150 then return yellow end
        return red
    end

    local function pingText(p)
        if p == nil then return "—" end
        if p <= 80 then return "🟢 " .. p .. "ms" elseif p <= 150 then return "🟡 " .. p .. "ms" end
        return "🔴 " .. p .. "ms"
    end

