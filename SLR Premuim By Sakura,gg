    Instance.new("UICorner", valueBox).CornerRadius = UDim.new(0, 6)
    
    local bar = Instance.new("Frame", Slider); bar.Name = "Bar"; bar.Size = UDim2.new(1, -40, 0, 6); bar.Position = UDim2.new(0, 20, 0, 45); bar.BackgroundColor3 = Color3.fromRGB(20,20,30); Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0); bar.ZIndex = 22; bar.ClipsDescendants = false
    local fill = Instance.new("Frame", bar); fill.Name = "Fill"; fill.Size = UDim2.new((default - min)/(max - min), 0, 1, 0); fill.BackgroundColor3 = Themes.Lofi.Accent; Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0); fill.ZIndex = 23
    local clk = Instance.new("TextButton", bar); clk.Size = UDim2.new(1, 0, 0, 24); clk.Position = UDim2.new(0, 0, 0.5, -12); clk.BackgroundTransparency = 1; clk.Text = ""; clk.ZIndex = 24

    local hoverDetector = Instance.new("TextButton", Slider)
    hoverDetector.Size = UDim2.new(1, 0, 1, 0)
    hoverDetector.BackgroundTransparency = 1
    hoverDetector.Text = ""
    hoverDetector.ZIndex = 20
    hoverDetector.AutoButtonColor = false
    
    hoverDetector.MouseEnter:Connect(function()
        local currentColor = Slider.BackgroundColor3
        local currentTransparency = Slider.BackgroundTransparency
        if CurrentTheme == "Sakura" then
            HoverTween(Slider, {BackgroundColor3 = Color3.fromRGB(230, 230, 240)}):Play()
        else
            HoverTween(Slider, {BackgroundTransparency = 0.15}):Play()
        end
        Slider:SetAttribute("HoverOriginalColor", currentColor)
        Slider:SetAttribute("HoverOriginalTransparency", currentTransparency)
    end)
    hoverDetector.MouseLeave:Connect(function()
        local originalColor = Slider:GetAttribute("HoverOriginalColor")
        local originalTransparency = Slider:GetAttribute("HoverOriginalTransparency")
        if CurrentTheme == "Sakura" and originalColor then
            HoverTween(Slider, {BackgroundColor3 = originalColor}):Play()
        elseif originalTransparency then
            HoverTween(Slider, {BackgroundTransparency = originalTransparency}):Play()
        end
    end)

    EliteLib.Flags[id] = default
    local function SetState(val)
        val = math.clamp(tonumber(val) or default, min, max)
        local per = (val - min) / (max - min)
        fill.Size = UDim2.new(per, 0, 1, 0)
        valueBox.Text = tostring(val)
        EliteLib.Flags[id] = val
        if callback then callback(val) end
    end
    EliteLib.Elements[id] = { Type = "Slider", Set = SetState, ValueBox = valueBox, LabelText = labelText }
    
    -- Handle text input
    valueBox.FocusLost:Connect(function(enterPressed)
        local inputVal = tonumber(valueBox.Text)
        if inputVal then
            SetState(inputVal)
        else
            valueBox.Text = tostring(EliteLib.Flags[id])
        end
    end)


    clk.MouseButton1Down:Connect(function()
        local dragConnName = "SliderDrag_" .. tostring(id)
        TrackConnection(dragConnName, Services.RunService.RenderStepped:Connect(function()
            local per = math.clamp((Services.UIS:GetMouseLocation().X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            SetState(math.floor(min + (max - min) * per))
        end))
        local rel
        rel = Services.UIS.InputEnded:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 then
                DisconnectConnection(dragConnName)
                rel:Disconnect()
            end
        end)
    end)
    addContentChaseGlow(Slider, 1.45, true)
    return Slider
end

