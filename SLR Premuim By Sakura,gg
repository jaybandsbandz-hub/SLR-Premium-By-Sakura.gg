-- Smooth “single band” chase gradients: avoids tight keypoints that read as rotating white dots
-- on long bars and small rounded squares.
local function chaseLight(accent)
    return Color3.fromRGB(
        math.min(255, accent.R * 255 + 90),
        math.min(255, accent.G * 255 + 90),
        math.min(255, accent.B * 255 + 100)
    )
end

local function softChaseSequence(accent, wideBar)
    local la = chaseLight(accent)
    local hi = accent:Lerp(Color3.new(1, 1, 1), 0.52)
    local b, c, d = 0.38, 0.5, 0.62
    if wideBar then
        b, c, d = 0.35, 0.5, 0.65
    end
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, accent),
        ColorSequenceKeypoint.new(b, la),
        ColorSequenceKeypoint.new(c, hi),
        ColorSequenceKeypoint.new(d, la),
        ColorSequenceKeypoint.new(1, accent),
    })
end

local function softChaseSequenceLofi(wideBar)
    local p0 = Color3.fromRGB(245, 125, 198)
    local p1 = Color3.fromRGB(188, 72, 168)
    local h = Color3.fromRGB(255, 228, 244)
    local b, c, d = 0.38, 0.5, 0.62
    if wideBar then
        b, c, d = 0.34, 0.5, 0.66
    end
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, p0),
        ColorSequenceKeypoint.new(b, p1),
        ColorSequenceKeypoint.new(c, h),
        ColorSequenceKeypoint.new(d, p1),
        ColorSequenceKeypoint.new(1, p0),
    })
end

-- Sakura: avoid chaseLight (it pushes B to 255 and reads purple/lavender on small chases)
local function softChaseSequenceSakura()
    local a = Themes.Sakura.Accent
    local mid = a:Lerp(Color3.fromRGB(255, 170, 205), 0.4)
    local hi = Color3.fromRGB(255, 230, 245)
    local b, c, d = 0.38, 0.5, 0.62
    return ColorSequence.new({
        ColorSequenceKeypoint.new(0, a),
        ColorSequenceKeypoint.new(b, mid),
        ColorSequenceKeypoint.new(c, hi),
        ColorSequenceKeypoint.new(d, mid),
        ColorSequenceKeypoint.new(1, a),
    })
end

-- Theme system: all animated menu chase (UIGradient) and glow halos (solid stroke) must go through these
local function getChaseColorSequenceForTheme(themeName, wideBar)
    wideBar = wideBar == true
    if themeName == "Lofi" then
        return softChaseSequenceLofi(wideBar)
    end
    if themeName == "Sakura" then
        return softChaseSequenceSakura()
    end
    local t = themeName and Themes[themeName]
    if t then
        return softChaseSequence(t.Accent, wideBar)
    end
    return softChaseSequence(Themes.Lofi.Accent, wideBar)
end

local function getMenuGlowStrokeColor(themeName)
    local t = themeName and Themes[themeName]
    if t then
        return t.Accent
    end
    return Themes.Lofi.Accent
end

