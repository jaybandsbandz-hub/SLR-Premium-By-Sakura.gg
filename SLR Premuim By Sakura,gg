;(function()
	local function pointOnMenuOpenChip(screenPos)
		local ap = MenuOpenChip.AbsolutePosition
		local asz = MenuOpenChip.AbsoluteSize
		return screenPos.X >= ap.X and screenPos.X <= ap.X + asz.X and screenPos.Y >= ap.Y and screenPos.Y <= ap.Y + asz.Y
	end

	local function clampMenuOpenChipPosition()
		local cam = workspace.CurrentCamera
		if not cam or not MenuOpenChip.Parent then
			return
		end
		local vs = cam.ViewportSize
		local m = 6
		local w = MenuOpenChip.Size.X.Offset
		local h = MenuOpenChip.Size.Y.Offset
		local p = MenuOpenChip.Position
		local x = math.clamp(p.X.Offset, m, math.max(m, vs.X - w - m))
		local topY = p.Y.Scale * vs.Y + p.Y.Offset
		topY = math.clamp(topY, m, math.max(m, vs.Y - h - m))
		MenuOpenChip.Position = UDim2.new(p.X.Scale, x, p.Y.Scale, topY - p.Y.Scale * vs.Y)
	end

	getgenv().SakuraClampMenuOpenChipPosition = clampMenuOpenChipPosition

	local chipDrag = {
		active = false,
		input = nil,
		pressScreen = nil,
		startPos = nil,
	}
	local CHIP_DRAG_SLOP = 10

	ConnectCore("SakuraMenuChipPointer", Services.UIS.InputBegan, function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then
			return
		end
		if not pointOnMenuOpenChip(Vector2.new(input.Position.X, input.Position.Y)) then
			return
		end
		chipDrag.active = true
		chipDrag.input = input
		chipDrag.pressScreen = Vector2.new(input.Position.X, input.Position.Y)
		chipDrag.startPos = MenuOpenChip.Position
	end)

	ConnectCore("SakuraMenuChipMove", Services.UIS.InputChanged, function(input)
		if not chipDrag.active or not chipDrag.input then
			return
		end
		local isMouseDrag = chipDrag.input.UserInputType == Enum.UserInputType.MouseButton1
			and input.UserInputType == Enum.UserInputType.MouseMovement
		local isTouchDrag = chipDrag.input == input and input.UserInputType == Enum.UserInputType.Touch
		if not isMouseDrag and not isTouchDrag then
			return
		end
		if isMouseDrag and not Services.UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
			return
		end
		local cur = Vector2.new(input.Position.X, input.Position.Y)
		local delta = cur - chipDrag.pressScreen
		if delta.Magnitude <= CHIP_DRAG_SLOP then
			return
		end
		MenuOpenChip.Position = UDim2.new(
			chipDrag.startPos.X.Scale,
			chipDrag.startPos.X.Offset + delta.X,
			chipDrag.startPos.Y.Scale,
			chipDrag.startPos.Y.Offset + delta.Y
		)
	end)

	ConnectCore("SakuraMenuChipRelease", Services.UIS.InputEnded, function(input)
		if not chipDrag.active or chipDrag.input ~= input then
			return
		end
		local startP = chipDrag.pressScreen
		chipDrag.active = false
		chipDrag.input = nil
		chipDrag.pressScreen = nil
		chipDrag.startPos = nil
		local endP = Vector2.new(input.Position.X, input.Position.Y)
		if (endP - startP).Magnitude <= CHIP_DRAG_SLOP + 2 then
			if MainFrame.Visible then
				SakuraMenuShell.hide()
			else
				SakuraMenuShell.show(true)
			end
		else
			pcall(getgenv().SakuraClampMenuOpenChipPosition)
		end
	end)
end)()

-- Luau limits ~200 locals per function scope (the implicit script body is one scope). Wrapping big regions in
-- `;(function() ... end)()` gives each chunk its own local register pool (same pattern as Modern ESP below).
;(function()

local homeScroll = TabPages["Home"]
if homeScroll then homeScroll.Visible = true end
MainFrame.Visible = false

local SessionStartTime = tick()
local FPSRolling = 60
local FPSAccumulator = 0
local FPSFrames = 0
local PingStatAccum = 0
local LastSessionSec = -1
local LuarmorHudAccum = 0
local LrmMirrorLeft = nil
local LrmMirrorTick = nil

local function luarmorReadGlobal(key)
	local function rawFrom(tbl)
		if type(tbl) == "table" then
			local v = rawget(tbl, key)
			if v ~= nil then
				return v
			end
		end
		return nil
	end
	local v = rawFrom(getgenv())
	if v == nil then
		v = rawFrom(_G)
	end
	if v == nil and type(shared) == "table" then
		v = rawFrom(shared)
	end
	if v == nil then
		pcall(function()
			if type(getrenv) == "function" then
				v = rawFrom(getrenv())
			end
		end)
	end
	if v == nil then
		pcall(function()
			if type(getfenv) == "function" then
				v = rawFrom(getfenv(0))
			end
		end)
	end
	return v
end

local function luarmorRuntimeDetected()
	return luarmorReadGlobal("LRM_SecondsLeft") ~= nil
		or luarmorReadGlobal("LRM_IsUserPremium") ~= nil
		or luarmorReadGlobal("LRM_UserNote") ~= nil
		or luarmorReadGlobal("LRM_ScriptName") ~= nil
		or luarmorReadGlobal("LRM_ScriptVersion") ~= nil
		or luarmorReadGlobal("LRM_TotalExecutions") ~= nil
		or luarmorReadGlobal("LRM_LinkedDiscordID") ~= nil
end

local function formatLuarmorDuration(sec)
	if sec == nil or type(sec) ~= "number" or sec ~= sec then
		return nil
	end
	if sec >= 1e200 or sec == math.huge then
		return "Lifetime"
	end
	sec = math.floor(math.max(0, sec))
	local d = math.floor(sec / 86400)
	sec -= d * 86400
	local h = math.floor(sec / 3600)
	sec -= h * 3600
	local m = math.max(0, math.floor(sec / 60))
	if d > 0 then
		return string.format("%dd %dh", d, h)
	end
	if h > 0 then
		return string.format("%dh %dm", h, m)
	end
	if m > 0 then
		return string.format("%dm", m)
	end
	return "<1m"
end

local function formatLuarmorDurationVerbose(sec)
	if sec == nil or type(sec) ~= "number" or sec ~= sec then
		return "—"
	end
	if sec >= 1e200 or sec == math.huge then
		return "Lifetime"
	end
	sec = math.floor(math.max(0, sec))
	local d = math.floor(sec / 86400)
	sec -= d * 86400
	local h = math.floor(sec / 3600)
	sec -= h * 3600
	local m = math.floor(sec / 60)
	local s = sec % 60
	if d > 0 then
		return string.format("%d Day%s %d Hrs %dMins %ds", d, (d == 1 and "" or "s"), h, m, s)
	end
	return string.format("%d Hrs %dMins %ds", h, m, s)
end

local function luarmorKeyTypeLabel()
	local prem = luarmorReadGlobal("LRM_IsUserPremium")
	local note = luarmorReadGlobal("LRM_UserNote")
	if type(note) == "string" and note ~= "" and note ~= "Not specified" then
		if prem == true then
			return "Premium · " .. note
		elseif prem == false then
			return "Standard · " .. note
		end
		return note
	end
	if prem == true then
		return "Premium"
	end
	if prem == false then
		return "Standard"
	end
	return "Standard"
end

local function luarmorKeyTypeColumnText()
	local note = luarmorReadGlobal("LRM_UserNote")
	if type(note) == "string" and note ~= "" and note ~= "Not specified" then
		return note
	end
	return luarmorKeyTypeLabel()
end

local function refreshLuarmorStatsHud()
	local keyV = getgenv().SakuraHomeLuarmorKeyValue
	local durV = getgenv().SakuraHomeLuarmorDurationValue
	if HomeLuarmorFooter then
		HomeLuarmorFooter.Visible = false
	end
	if not (keyV and durV) then
		return
	end

	local show = (CurrentTab == "Home") and MainFrame and MainFrame.Visible
	if not show then
		keyV.Text = "—"
		durV.Text = "—"
		return
	end

	if not luarmorRuntimeDetected() then
		keyV.Text = "—"
		durV.Text = "—"
		return
	end

	local raw = luarmorReadGlobal("LRM_SecondsLeft")
	if type(raw) == "string" then
		raw = tonumber(raw)
	end
	local eff = raw
	if type(raw) == "number" and raw == raw and raw < 1e200 and raw ~= math.huge then
		local projected = nil
		if LrmMirrorLeft ~= nil and LrmMirrorTick ~= nil then
			projected = math.max(0, LrmMirrorLeft - (tick() - LrmMirrorTick))
		end
		if LrmMirrorLeft == nil or projected == nil or math.abs(raw - projected) > 90 then
			LrmMirrorLeft = raw
			LrmMirrorTick = tick()
		end
		eff = math.max(0, LrmMirrorLeft - (tick() - LrmMirrorTick))
	end

	local kt = luarmorKeyTypeColumnText()
	keyV.Text = kt
	if type(eff) == "number" and eff == eff then
		durV.Text = formatLuarmorDurationVerbose(eff)
	else
		durV.Text = "—"
	end
end

local function setStatText(card, cardField, hudLabel, text)
    if card and card:FindFirstChild(cardField) then
        card[cardField].Text = text
    end
    if hudLabel then
        hudLabel.Text = text
    end
end

-- Primary: LocalPlayer:GetNetworkPing() → round-trip time in **seconds** (×1000 for ms). Matches the
-- Shift+F5-style client RTT more closely than raw Stats "Data Ping" alone (which can differ in unit/smoothing).
local function getPingMs()
    local lp = Services.Players.LocalPlayer
    if lp then
        local ok, sec = pcall(function()
            return lp:GetNetworkPing()
        end)
        if ok and type(sec) == "number" and sec == sec and sec >= 0 then
            return sec * 1000
        end
    end
    local ok2, p = pcall(function()
        return Services.Stats.Network.ServerStatsItem["Data Ping"]:GetValue()
    end)
    if ok2 and type(p) == "number" and p == p and p > 0 then
        if p < 1 then
            return p * 1000
        else
            return p
        end
    end
    return nil
end

ConnectCore("PremiumStatsUpdater", Services.RunService.Heartbeat, function(dt)
    if not ((StatsBarHUD and StatsBarHUD.Visible) or (MainFrame and MainFrame.Visible)) then
        return
    end
    FPSAccumulator = FPSAccumulator + dt
    FPSFrames = FPSFrames + 1
    PingStatAccum = PingStatAccum + dt

    -- ~4 updates/sec: unsmoothed RTT, closer to the built-in readout (no 75/25 EMA lag).
    if PingStatAccum >= 0.25 then
        PingStatAccum = 0
        local ms = getPingMs()
        if type(ms) == "number" and ms == ms and ms >= 0 and ms <= 20000 then
            setStatText(PingCard, "Value", PingValue, string.format("%dms", math.floor(ms + 0.5)))
        end
    end

    if FPSAccumulator >= 1 then
        -- Mean FPS = frames / wall time in window (standard average; matches a 1s FPS readout)
        FPSRolling = math.max(0, math.floor(FPSFrames / math.max(1e-4, FPSAccumulator) + 0.5))
        FPSAccumulator = 0
        FPSFrames = 0
        if FPSRolling > 9999 then
            FPSRolling = 9999
        end
        setStatText(FPSCard, "Value", FPSValue, tostring(FPSRolling))
    end

    local elapsed = math.max(0, math.floor(tick() - SessionStartTime))
    if elapsed ~= LastSessionSec then
        LastSessionSec = elapsed
        setStatText(SessionCard, "Value", SessionValue, string.format("%d:%02d", math.floor(elapsed / 60), elapsed % 60))
    end

    LuarmorHudAccum += dt
    if LuarmorHudAccum >= 0.5 then
        LuarmorHudAccum = 0
        pcall(refreshLuarmorStatsHud)
    end
end)

