local LockedAimCharacter = nil
local LastKeyState = false
local FrameCounter = 0
local AimVisLastCharacter = nil
local AimVisCached = true
local AimVisRayParams = RaycastParams.new()
AimVisRayParams.FilterType = Enum.RaycastFilterType.Blacklist
AimVisRayParams.IgnoreWater = true

ConnectCore("AimEspRender", Services.RunService.RenderStepped, function()
    FrameCounter = FrameCounter + 1
    if not (Settings.Aim and Settings.Aim.Enabled) and not (Settings.Esp and Settings.Esp.Printers) then
        LockedAimCharacter = nil
        return
    end

    if SakuraIsMainMenuCovering() then
        LockedAimCharacter = nil
        if Settings.Esp and Settings.Esp.Printers then
            hidePrinterEspDrawingsForMenu()
        end
        return
    end

    local menuVisible = MainFrame.Visible
    local keyActive = Settings.Aim and Settings.Aim.Key ~= nil and IsKeyActive(Settings.Aim.Key)
    local aimCtxOk = IsAimbotInteractionAllowed()
    local aimDrive = keyActive and aimCtxOk
    
    if LastKeyState and not aimDrive then
        LockedAimCharacter = nil
    end
    LastKeyState = aimDrive

    local myHum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid")
    if myHum and myHum.Health <= 0 then
        LockedAimCharacter = nil
    end
    
    if Settings.Aim and Settings.Aim.Enabled and aimDrive and not menuVisible and myHum and myHum.Health > 0 then
        local function aimLockStillValid()
            if not LockedAimCharacter or not LockedAimCharacter.Parent then
                return false
            end
            local th = LockedAimCharacter:FindFirstChildOfClass("Humanoid")
            if not th or th.Health <= 0 then
                return false
            end
            local isPlayerChar = Services.Players:GetPlayerFromCharacter(LockedAimCharacter) ~= nil
            if Settings.Aim.NpcAimbot then
                return not isPlayerChar
            end
            return isPlayerChar
        end

        if not aimLockStillValid() then
            if Settings.Aim.NpcAimbot then
                LockedAimCharacter = ResolveNpcAimLockedCharacter()
            else
                local plr = GetClosestTarget()
                LockedAimCharacter = plr and plr.Character or nil
            end
        end
        
        if LockedAimCharacter then
            local Camera = workspace.CurrentCamera
            local targetPart = Settings.Aim.NpcAimbot and "Head" or ((Settings.Aim and Settings.Aim.Part) or "Head")
            local tPart = LockedAimCharacter:FindFirstChild(targetPart)
            
            if not tPart and not Settings.Aim.NpcAimbot then
                if targetPart == "UpperTorso" or targetPart == "LowerTorso" then
                    tPart = LockedAimCharacter:FindFirstChild("Torso") or LockedAimCharacter:FindFirstChild("UpperTorso")
                elseif targetPart == "Torso" then
                    tPart = LockedAimCharacter:FindFirstChild("UpperTorso") or LockedAimCharacter:FindFirstChild("Torso")
                end
            end
            
            if tPart then
                local isVisible = true
                if Settings.Aim.VisibleCheck then
                    local refreshVis = (FrameCounter % 2 == 0) or (LockedAimCharacter ~= AimVisLastCharacter)
                    AimVisLastCharacter = LockedAimCharacter
                    if refreshVis then
                    local char = LocalPlayer.Character
                    if char then
                        local rayOrigin = Camera.CFrame.Position
                        local rayDistance = (tPart.Position - rayOrigin).Magnitude
                        local rayDirection = (tPart.Position - rayOrigin).Unit * rayDistance
                            AimVisRayParams.FilterDescendantsInstances = { char, LockedAimCharacter }
                            local rayResult = workspace:Raycast(rayOrigin, rayDirection, AimVisRayParams)
                        isVisible = not rayResult
                        end
                        AimVisCached = isVisible
                    else
                        isVisible = AimVisCached
                    end
                end
                
                if isVisible then
                    local vPos = tPart.Position
                    
                    local camPos = Camera.CFrame.Position
                    local targetCFrame = CFrame.new(camPos, vPos)
                    
                    if Settings.Aim.Smooth and Settings.Aim.Smooth > 0 then 
                        local alpha = 1 - (Settings.Aim.Smooth / 100)
                        Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, alpha)
                    else 
                        Camera.CFrame = targetCFrame
                    end
                end
            end
        end
    else
        LockedAimCharacter = nil
    end

    if Settings.Esp and Settings.Esp.Printers then
        if (FrameCounter % 60) == 0 then
            local printersFolder = workspace:FindFirstChild("Printers")
            local playerHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        
        if printersFolder and playerHRP then
            local currentPrinters = {}
            local printerGroups = {}
            
            for _, printer in pairs(printersFolder:GetChildren()) do
                local printerName = printer.Name
                if printer:IsA("Model") and (printerName == "Basic Printer" or printerName == "Premium Printer" or printerName == "Eco Printer") then
                    local ownerValue = printer:FindFirstChild("Owner")
                    local isOwned = ownerValue and ownerValue:IsA("StringValue") and ownerValue.Value == LocalPlayer.Name
                    
                    if not isOwned then
                        local pPart = printer:FindFirstChildWhichIsA("BasePart", true)
                        if pPart and (pPart.Position - playerHRP.Position).Magnitude > 5 then
                            currentPrinters[printer] = true
                            
                            if not EspDrawings[printer] then
                                local highlight = Instance.new("Highlight")
                                highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                                highlight.Adornee = printer
                                highlight.Parent = printer
                                highlight.FillTransparency = 0.7
                                highlight.OutlineTransparency = 0
                                
                                local nameBillboard = Instance.new("BillboardGui")
                                nameBillboard.Parent = pPart
                                nameBillboard.AlwaysOnTop = true
                                nameBillboard.Size = UDim2.new(0, 200, 0, 20)
                                nameBillboard.StudsOffset = Vector3.new(0, 5, 0)
                                
                                local nameLabel = Instance.new("TextLabel")
                                nameLabel.Parent = nameBillboard
                                nameLabel.Size = UDim2.new(1, 0, 1, 0)
                                nameLabel.BackgroundTransparency = 1
                                nameLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                                nameLabel.TextStrokeTransparency = 0
                                nameLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                nameLabel.TextSize = 15
                                nameLabel.Font = Enum.Font.SourceSansBold
                                nameLabel.TextXAlignment = Enum.TextXAlignment.Center
                                nameLabel.TextYAlignment = Enum.TextYAlignment.Center
                                nameLabel.Visible = false
                                
                                local distBillboard = Instance.new("BillboardGui")
                                distBillboard.Parent = pPart
                                distBillboard.AlwaysOnTop = true
                                distBillboard.Size = UDim2.new(0, 200, 0, 18)
                                distBillboard.StudsOffset = Vector3.new(0, 3.5, 0)
                                
                                local distLabel = Instance.new("TextLabel")
                                distLabel.Parent = distBillboard
                                distLabel.Size = UDim2.new(1, 0, 1, 0)
                                distLabel.BackgroundTransparency = 1
                                distLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
                                distLabel.TextStrokeTransparency = 0
                                distLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                                distLabel.TextSize = 13
                                distLabel.Font = Enum.Font.SourceSansBold
                                distLabel.TextXAlignment = Enum.TextXAlignment.Center
                                distLabel.TextYAlignment = Enum.TextYAlignment.Center
                                distLabel.Visible = false
                                
                                local color
                                if printerName == "Premium Printer" then
                                    color = Color3.fromRGB(255, 215, 0)
                                elseif printerName == "Eco Printer" then
                                    color = Color3.fromRGB(0, 150, 255)
                                else
                                    color = Color3.fromRGB(100, 255, 100)
                                end
                                
                                highlight.OutlineColor = color
                                highlight.FillColor = color
                                
                                EspDrawings[printer] = {
                                    Highlight = highlight,
                                    NameText = nameLabel,
                                    DistText = distLabel,
                                    Part = pPart,
                                    Name = printerName,
                                    Color = color,
                                    GroupLabel = nil,
                                    GroupColor = nil,
                                    GroupCenter = nil,
                                    IsGrouped = false,
                                    LastDistance = 0
                                }
                            end
                            
                            EspDrawings[printer].Highlight.Enabled = true
                            
                            local distance = (pPart.Position - playerHRP.Position).Magnitude
                            EspDrawings[printer].LastDistance = distance
                            
                            local grouped = false
                            for _, group in ipairs(printerGroups) do
                                if (pPart.Position - group.center).Magnitude <= 25 then
                                    table.insert(group.printers, printer)
                                    local totalPos = Vector3.new(0, 0, 0)
                                    for _, p in ipairs(group.printers) do
                                        totalPos = totalPos + EspDrawings[p].Part.Position
                                    end
                                    group.center = totalPos / #group.printers
                                    grouped = true
                                    break
                                end
                            end
                            
                            if not grouped then
                                table.insert(printerGroups, {
                                    center = pPart.Position,
                                    printers = {printer}
                                })
                            end
                        end
                    end
                end
            end
            
            for _, group in ipairs(printerGroups) do
                if #group.printers >= 2 then
                    local typeCounts = {Basic = 0, Premium = 0, Eco = 0}
                    for _, printer in ipairs(group.printers) do
                        local espData = EspDrawings[printer]
                        if espData.Name == "Basic Printer" then
                            typeCounts.Basic = typeCounts.Basic + 1
                        elseif espData.Name == "Premium Printer" then
                            typeCounts.Premium = typeCounts.Premium + 1
                        elseif espData.Name == "Eco Printer" then
                            typeCounts.Eco = typeCounts.Eco + 1
                        end
                        espData.IsGrouped = true
                    end
                    
                    local parts = {}
                    if typeCounts.Basic > 0 then 
                        table.insert(parts, typeCounts.Basic > 1 and (typeCounts.Basic .. "x Basic") or "Basic") 
                    end
                    if typeCounts.Premium > 0 then 
                        table.insert(parts, typeCounts.Premium > 1 and (typeCounts.Premium .. "x Premium") or "Premium") 
                    end
                    if typeCounts.Eco > 0 then 
                        table.insert(parts, typeCounts.Eco > 1 and (typeCounts.Eco .. "x Eco") or "Eco") 
                    end
                    local groupText = "Printers (" .. table.concat(parts, ", ") .. ")"
                    
                    local groupColor = Color3.fromRGB(100, 255, 100)
                    if typeCounts.Premium > 0 then
                        groupColor = Color3.fromRGB(255, 215, 0)
                    elseif typeCounts.Eco > 0 then
                        groupColor = Color3.fromRGB(0, 150, 255)
                    end
                    
                    local firstPrinter = group.printers[1]
                    EspDrawings[firstPrinter].GroupLabel = groupText
                    EspDrawings[firstPrinter].GroupColor = groupColor
                    EspDrawings[firstPrinter].GroupCenter = group.center
                else
                    local printer = group.printers[1]
                    EspDrawings[printer].IsGrouped = false
                    EspDrawings[printer].GroupLabel = nil
                end
            end
            
            for printer, data in pairs(EspDrawings) do
                if not currentPrinters[printer] then
                    if data.Highlight then data.Highlight:Destroy() end
                    if data.NameText and data.NameText.Parent then data.NameText.Parent:Destroy() end
                    if data.DistText and data.DistText.Parent then data.DistText.Parent:Destroy() end
                    EspDrawings[printer] = nil
                end
            end
        end
        end  
        
        if not MainFrame.Visible then
            if (FrameCounter % 2) == 0 then
                local liveHRP = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                for printer, espData in pairs(EspDrawings) do
                    if espData.Highlight.Enabled then
                        local cachedDist = espData.LastDistance or 0
                        local liveDist = (liveHRP and espData.Part) and math.floor((espData.Part.Position - liveHRP.Position).Magnitude) or math.floor(cachedDist)

                        local nameOffset, distOffset
                        if cachedDist >= 850 then
                            nameOffset = 40
                            distOffset = 20
                        elseif cachedDist >= 600 then
                            nameOffset = 32
                            distOffset = 18
                        elseif cachedDist >= 400 then
                            nameOffset = 26
                            distOffset = 15
                        elseif cachedDist >= 250 then
                            nameOffset = 20
                            distOffset = 12
                        elseif cachedDist >= 125 then
                            nameOffset = 15
                            distOffset = 9
                        else
                            nameOffset = 10
                            distOffset = 6
                        end

                        if espData.GroupLabel then
                            espData.NameText.Text = espData.GroupLabel
                            espData.NameText.TextColor3 = espData.GroupColor
                            espData.NameText.Parent.StudsOffset = Vector3.new(0, nameOffset, 0)
                            espData.NameText.Visible = true

                            local distStr = liveDist .. "m"
                            if espData.DistText.Text ~= distStr then
                                espData.DistText.Text = distStr
                            end
                            espData.DistText.TextColor3 = espData.GroupColor
                            espData.DistText.Parent.StudsOffset = Vector3.new(0, distOffset, 0)
                            espData.DistText.Visible = true
                        elseif espData.IsGrouped then
                            espData.NameText.Visible = false
                            espData.DistText.Visible = false
                        else
                            espData.NameText.Text = espData.Name:gsub(" Printer", "")
                            espData.NameText.TextColor3 = espData.Color
                            espData.NameText.Parent.StudsOffset = Vector3.new(0, nameOffset, 0)
                            espData.NameText.Visible = true

                            local distStr = liveDist .. "m"
                            if espData.DistText.Text ~= distStr then
                                espData.DistText.Text = distStr
                            end
                            espData.DistText.TextColor3 = espData.Color
                            espData.DistText.Parent.StudsOffset = Vector3.new(0, distOffset, 0)
                            espData.DistText.Visible = true
                        end
                    end
                end
            end
        else
            for printer, espData in pairs(EspDrawings) do
                if espData.NameText then espData.NameText.Visible = false end
                if espData.DistText then espData.DistText.Visible = false end
            end
        end
    else
        clearPrinterEspDrawings()
    end

    getgenv().EliteHubLockedTarget = Services.Players:GetPlayerFromCharacter(LockedAimCharacter)
    getgenv().EliteHubLockedAimCharacter = LockedAimCharacter
end)

