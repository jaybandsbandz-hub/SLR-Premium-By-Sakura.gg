local function readLifetimeNumberFromPath(path)
    local v = 0
    pcall(function()
        if not isfile(path) then return end
        local raw = readfile(path)
        if not raw or raw == "" then return end
        raw = raw:gsub("^%s+", ""):gsub("%s+$", "")
        local num = tonumber(raw)
        if num then v = math.max(0, math.floor(num)) end
    end)
    return v
end

local function loadLifetimeCryptoProfit()
    local paths = {
        CRYPTO_LIFETIME_PROFIT_FILE,
        CRYPTO_LIFETIME_PROFIT_BACKUP,
        "EliteHubV2_Configs/" .. CRYPTO_LIFETIME_FILENAME,
        "EliteHubV2_Configs/crypto_lifetime_profit.bak.txt",
        CRYPTO_LIFETIME_FILENAME, 
    }
    local best = 0
    for _, path in ipairs(paths) do
        best = math.max(best, readLifetimeNumberFromPath(path))
    end
    return best
end

local function saveLifetimeCryptoProfit()
    pcall(function()
        if not isfolder(ConfigFolder) then makefolder(ConfigFolder) end
