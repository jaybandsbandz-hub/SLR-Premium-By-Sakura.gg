        local rowBg = (themeName == "Sakura" and Color3.fromRGB(250, 248, 252) or contentPanel:Lerp(Color3.new(0, 0, 0), 0.12))
        local rowAlt = rowBg:Lerp(Color3.new(0, 0, 0), 0.08)
