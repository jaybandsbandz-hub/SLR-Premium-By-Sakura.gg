local function AnimateScannerInlineClose()
    local box = ScanMenuChrome
    if not box or not ScanDisplay.Visible or ScannerInlineAnimating then
        return
    end
    ScannerInlineAnimating = true
    box.Visible = true

    local originalPos = box.Position
    local originalAnchor = box.AnchorPoint

    box.ClipsDescendants = true
    box.AnchorPoint = Vector2.new(0.5, 0.5)
    box.Position = UDim2.new(0.5, 0, 0.5, 0)
    ScanInlineScale.Scale = 1

    local tw = Services.Tween:Create(
        ScanInlineScale,
        TweenInfo.new(PANEL_ANIM_DURATION, Enum.EasingStyle.Quint, Enum.EasingDirection.In),
        { Scale = 0 }
