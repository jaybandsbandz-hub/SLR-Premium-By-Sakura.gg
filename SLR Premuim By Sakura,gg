        local vehHot = veh and veh.SpeedEnabled and (veh.Speed or 0) > 0 and hum.SeatPart
        local jumpCfg = mov and mov.Jump and mov.Jump.Enabled and (mov.Jump.Target or 0) > 0
        if not flyBV and not flyHot and not vehHot and not jumpCfg then
